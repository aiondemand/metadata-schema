@base <http://aiod.eu/data/schemas/> .

<http://aiod.eu/data/schemas/> rdf:type owl:Ontology ;
                                owl:imports <http://www.w3.org/2004/02/skos/core> ;
                                dct:bibliographicCitation "Antonis Koukourikos, Marianna Tsigkou, Costas Spyropoulos. Taxonomies for the AIoD Metadata Model."^^rdfs:Literal ;
                                dct:description "A collection of SKOS-based taxonomies designed to be used in conjunction with the AIoD Metadata Model. Each taxonomy includes concept schemes and concepts enriched with metadata."@en ;
                                dct:issued "2025-04-08"^^xsd:date ;
                                dct:modified "2025-04-08"^^xsd:date ;
                                dct:publisher "Institute of Informatics and Telecommunications (IIT), NCSR Demokritos" ;
                                dct:title "Taxonomies for the AIoD Metadata Model"@en ;
                                vann:preferredNamespacePrefix "schemasAIoD" ;
                                vann:preferredNamespaceUri "http://aiod.eu/data/schemas/" .

