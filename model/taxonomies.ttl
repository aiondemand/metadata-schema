###  http://aiod.eu/data/schemas/ManifoldLearning
:ManifoldLearning rdf:type owl:NamedIndividual ,
                           ns1:Concept ;
                  ns1:inScheme :Approach ;
                  ns1:notation "con265"@en ;
                  <http://purl.org/dc/elements/1.1/source> "Internal documentation and taxonomies derived from the Network of Excellence initiative (AI-focused EU networks)."@en ;
                  rdfs:label "Manifold Learning"@en ;
                  ns1:definition "Techniques that aim to project high-dimensional data, potentially existing across non-linear manifolds which cannot be adequately captured by linear decomposition methods, onto lower-dimensional latent manifolds, with the goal of either visualizing the data in the low-dimensional space, or learning the mapping"@en .


