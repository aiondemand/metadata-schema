###  http://aiod.eu/data/schemas/AIAndCopyright
:AIAndCopyright rdf:type owl:NamedIndividual ,
                         ns1:Concept ;
                ns1:inScheme :Approach ;
                ns1:notation "con015"@en ;
                <http://purl.org/dc/elements/1.1/source> "Internal documentation and taxonomies derived from the Network of Excellence initiative (AI-focused EU networks)."@en ;
                rdfs:label "AI and Copyright"@en ;
                ns1:definition "The legal and policy issues that arise from the integration and utilisation of artificial intelligence."@en .


