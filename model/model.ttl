                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :invoked_by ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass :AIResource
                                       ] ;
                       rdfs:comment "The actual conduct of a separate procedure within a workflow." ;
                       rdfs:label "Workflow Execution Step"@en .


###  http://aiod.eu/data/WorkflowStep
:WorkflowStep rdf:type owl:Class ;
              rdfs:subClassOf :AIAsset ,
                              [ rdf:type owl:Restriction ;
