#################################################################
#    Classes
#################################################################

###  http://aiod.eu/data/AIAsset
:AIAsset rdf:type owl:Class ;
         rdfs:subClassOf :AIResource ;
         rdfs:comment "An accessible and usable asset pertaining to AI research and applications." ;
         rdfs:label "AI Asset"@en .


###  http://aiod.eu/data/AIResource
:AIResource rdf:type owl:Class ;
            owl:equivalentClass dcat:Resource ;
            rdfs:subClassOf :AIoDConcept ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :aiod_entry ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :AIoDEntry
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :media ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass :Multimedia
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :name ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
            rdfs:comment "A source of information, guidance or research and development assets for AI." ;
            rdfs:label "AI Resource"@en .


###  http://aiod.eu/data/AIoDConcept
:AIoDConcept rdf:type owl:Class ;
             rdfs:comment "The top level entity of the model." ;
             rdfs:label "AIoD Concept"@en .


###  http://aiod.eu/data/AIoDEntry
:AIoDEntry rdf:type owl:Class ;
           rdfs:subClassOf :AIoDConcept ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :editor ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :ContactDetails
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :status ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
           rdfs:comment "The entity defines metadata properties pertaining to AIoD platform-specific characteristics of a resource." ;
           rdfs:label "AIoD Entry"@en .


###  http://aiod.eu/data/Accelerator
:Accelerator rdf:type owl:Class ;
             rdfs:subClassOf :ComputeComponent ;
             rdfs:comment "The part of a computing system responsible for accelerating specific computational tasks." ;
             rdfs:label "Accelerator"@en .


###  http://aiod.eu/data/Actor
:Actor rdf:type owl:Class ;
       rdfs:subClassOf :Device ;
       rdfs:label "Actor"@en .


###  http://aiod.eu/data/Actuation
:Actuation rdf:type owl:Class ;
           rdfs:subClassOf :AIoDConcept ;
           rdfs:label "Actuation"@en .


###  http://aiod.eu/data/Agent
:Agent rdf:type owl:Class ;
       owl:equivalentClass dct:Agent ,
                           foaf:Agent ;
       rdfs:subClassOf :EcosystemResource ;
       rdfs:comment "The direct performer or driver of the action (animate or inanimate)." .


###  http://aiod.eu/data/Announcement
:Announcement rdf:type owl:Class ;
              rdfs:subClassOf :NewsItem ;
              rdfs:comment "An article containing official information or updates." ;
              rdfs:label "Announcement"@en .


###  http://aiod.eu/data/Approach
:Approach rdf:type owl:Class ;
          rdfs:subClassOf :AIoDConcept ;
          rdfs:comment "The specific point of view employed to implement a solution." ;
          rdfs:label "Approach"@en .


###  http://aiod.eu/data/Assessment
:Assessment rdf:type owl:Class ;
            rdfs:subClassOf :AIoDConcept ;
            rdfs:comment "A systematic process of analysis used to determine characteristics, performance, or compliance of an entity, system, or condition." ;
            rdfs:label "Assessment"@en .


###  http://aiod.eu/data/Audio
:Audio rdf:type owl:Class ;
       rdfs:subClassOf :Multimedia ;
       rdfs:comment "A recorded sound." ;
       rdfs:label "Audio"@en .


###  http://aiod.eu/data/BusinessFunction
:BusinessFunction rdf:type owl:Class ;
                  rdfs:subClassOf :EcosystemResource ;
                  rdfs:comment "The area of operations within a business." ;
                  rdfs:label "Business Function"@en .


###  http://aiod.eu/data/BusinessProblem
:BusinessProblem rdf:type owl:Class ;
                 rdfs:subClassOf :Problem ;
                 rdfs:comment "The specific issue or challenge faced by a company." ;
                 rdfs:label "Business Problem"@en .


###  http://aiod.eu/data/BusinessSector
:BusinessSector rdf:type owl:Class ;
                rdfs:subClassOf :Expertise ;
                rdfs:comment "The distinct subset of the economy." ;
                rdfs:label "Business Sector"@en .


###  http://aiod.eu/data/CPU
:CPU rdf:type owl:Class ;
     rdfs:subClassOf :ComputeComponent ;
     rdfs:comment "The central processor of a computer system." ;
     rdfs:label "CPU"@en .


###  http://aiod.eu/data/Camera
:Camera rdf:type owl:Class ;
        rdfs:subClassOf :Sensor .


###  http://aiod.eu/data/CaseStudy
:CaseStudy rdf:type owl:Class ;
           rdfs:subClassOf :Project ;
           rdfs:comment "A contractually defined initiative aimed to achieve specific objectives." ;
           rdfs:label "Case Study"@en .


###  http://aiod.eu/data/Challenge
:Challenge rdf:type owl:Class ;
           rdfs:subClassOf :Project ;
           rdfs:comment "A competitive initiative aimed to achieve specific objectives." ;
           rdfs:label "Challenge"@en .


###  http://aiod.eu/data/Classification
:Classification rdf:type owl:Class ;
                rdfs:subClassOf :AIoDConcept ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :classification_id ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:anyURI
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :classification_scheme ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:anyURI
                                ] ;
                rdfs:comment "A means to categorize entities under classification schemes." ;
                rdfs:label "Classification"@en .


###  http://aiod.eu/data/CloudComputeAsset
:CloudComputeAsset rdf:type owl:Class ;
                   rdfs:subClassOf :ComputationalAsset ;
                   rdfs:label "Cloud Compute Asset"@en .


###  http://aiod.eu/data/CompanyRevenue
:CompanyRevenue rdf:type owl:Class ;
                rdfs:subClassOf :AIoDConcept ;
                rdfs:comment "The total income generated by a company from its operations."@en ;
                rdfs:label "Company Revenue"@en .


###  http://aiod.eu/data/CompanySize
:CompanySize rdf:type owl:Class ;
             rdfs:subClassOf :AIoDConcept ;
             rdfs:comment "The classification of a company based on the number of employees it has."@en ;
             rdfs:label "Company Size"@en .


###  http://aiod.eu/data/ComputationalAsset
:ComputationalAsset rdf:type owl:Class ;
                    rdfs:subClassOf :AIAsset ;
                    rdfs:comment "Physical or virtual infrastuctures providing computational capabilities." ;
                    rdfs:label "Computational Asset"@en .


###  http://aiod.eu/data/ComputationalRequirement
:ComputationalRequirement rdf:type owl:Class ;
                          rdfs:subClassOf :AIoDConcept ;
                          rdfs:comment "The computing resources required to perform a function." ;
                          rdfs:label "Computational Requirement"@en .


###  http://aiod.eu/data/ComputeAsset
:ComputeAsset rdf:type owl:Class ;
              rdfs:subClassOf :ComputationalAsset ;
              rdfs:label "Compute Asset"@en .


###  http://aiod.eu/data/ComputeComponent
:ComputeComponent rdf:type owl:Class ;
                  rdfs:subClassOf :AIoDConcept ;
                  rdfs:comment "A hardware unit that contributes to computational performance."@en ;
                  rdfs:label "Compute Component"@en .


###  http://aiod.eu/data/ContactDetails
:ContactDetails rdf:type owl:Class ;
                rdfs:subClassOf :AIoDConcept ;
                rdfs:comment "Information related to communication methods." ;
                rdfs:label "Contact Details"@en .


###  http://aiod.eu/data/Container
:Container rdf:type owl:Class ;
           rdfs:subClassOf :Distribution ;
           rdfs:label "Container"@en .


###  http://aiod.eu/data/Course
:Course rdf:type owl:Class ;
        rdfs:subClassOf :EducationalResource ;
        rdfs:comment "A systematic training programme." ;
        rdfs:label "Course"@en .


###  http://aiod.eu/data/DataDownload
:DataDownload rdf:type owl:Class ;
              rdfs:subClassOf :Distribution ;
              rdfs:label "Data Download"@en .


###  http://aiod.eu/data/DataModel
:DataModel rdf:type owl:Class ;
           rdfs:subClassOf :Model ;
           rdfs:comment "A structured way to organize and relate data."@en ;
           rdfs:label "Data Model"@en .


###  http://aiod.eu/data/DataService
:DataService rdf:type owl:Class ;
             rdfs:subClassOf :Distribution ;
             rdfs:label "Data Service"@en .


###  http://aiod.eu/data/Dataset
:Dataset rdf:type owl:Class ;
         owl:equivalentClass dcat:Dataset ;
         rdfs:subClassOf :AIAsset ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :size ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Size
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :spatial_coverage ;
                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Location
                         ] ;
         rdfs:comment "A collection of data, published or curated by a specific agency." ;
         rdfs:label "Dataset"@en .


###  http://aiod.eu/data/DeveloperService
:DeveloperService rdf:type owl:Class ;
                  rdfs:subClassOf :Service ;
                  rdfs:label "Developer Service"@en .


###  http://aiod.eu/data/Device
:Device rdf:type owl:Class ;
        rdfs:subClassOf :AIoDConcept ;
        rdfs:comment "An artifact whose purpose is to serve as an instrument in a specific subclass of a process."@en ;
        rdfs:label "Device"@en .


###  http://aiod.eu/data/Distribution
:Distribution rdf:type owl:Class ;
              rdfs:subClassOf :AIoDConcept ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :has_computational_requirement ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :ComputationalRequirement
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :content_url ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:anyURI
                              ] ;
              rdfs:comment "A specific form of packaging and means of distributing an AI Asset." ;
              rdfs:label "Distribution"@en .


###  http://aiod.eu/data/DocumentaryResource
:DocumentaryResource rdf:type owl:Class ;
                     rdfs:subClassOf :KnowledgeAsset ;
                     rdfs:comment "A document that provides information relevant to a topic or entity."@en ;
                     rdfs:label "Documentary Resource"@en .


###  http://aiod.eu/data/ECProject
:ECProject rdf:type owl:Class ;
           rdfs:subClassOf :Project ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :eu_contribution ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:decimal
                           ] ;
           rdfs:comment "A project directly funded or co-funded by the European Commission." ;
           rdfs:label "EC Project"@en .


###  http://aiod.eu/data/EcosystemResource
:EcosystemResource rdf:type owl:Class ;
                   rdfs:subClassOf :AIResource ;
                   rdfs:comment "Indirect contributions to the research and development of AI assets." ;
                   rdfs:label "Ecosystem Resource"@en .


###  http://aiod.eu/data/EducationalCompetency
:EducationalCompetency rdf:type owl:Class ;
                       rdfs:subClassOf :AIoDConcept ;
                       rdfs:label "Educational Competency Level"@en .


###  http://aiod.eu/data/EducationalLevel
:EducationalLevel rdf:type owl:Class ;
                  rdfs:subClassOf :AIoDConcept ;
                  rdfs:label "Educational Level"@en .


###  http://aiod.eu/data/EducationalResource
:EducationalResource rdf:type owl:Class ;
                     rdfs:subClassOf :EcosystemResource ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty :offered_by ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass :Organisation
                                     ] ;
                     rdfs:comment "A resource designed for educational purposes." ;
                     rdfs:label "Educational Resource"@en .


###  http://aiod.eu/data/Event
:Event rdf:type owl:Class ;
       rdfs:subClassOf :EcosystemResource ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :duration ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Size
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :organiser ;
                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Agent
                       ] ;
       rdfs:comment "An event happening at a certain time and location, with a specific scope." ;
       rdfs:label "Event"@en .


###  http://aiod.eu/data/EventMode
:EventMode rdf:type owl:Class ;
           rdfs:subClassOf :AIoDConcept ;
           rdfs:label "Event Mode"@en .


###  http://aiod.eu/data/EventStatus
:EventStatus rdf:type owl:Class ;
             rdfs:subClassOf :AIoDConcept ;
             rdfs:label "Event Status"@en .


###  http://aiod.eu/data/Experiment
:Experiment rdf:type owl:Class ;
            rdfs:subClassOf :AIAsset ;
            rdfs:comment "A procedure conducted to test theoretical knowledge." ;
            rdfs:label "Experiment"@en .


###  http://aiod.eu/data/ExperimentExecution
:ExperimentExecution rdf:type owl:Class ;
                     rdfs:subClassOf :AIAsset ;
                     rdfs:comment "The actual conduct of a previously defined experiment." ;
                     rdfs:label "Experiment Execution"@en .


###  http://aiod.eu/data/ExpertGroup
:ExpertGroup rdf:type owl:Class ;
             rdfs:subClassOf :Agent ;
             rdfs:comment "A team of experts who have no legal foundation and are assembled for a specific purpose." ;
             rdfs:label "Expert Group"@en .


###  http://aiod.eu/data/Expertise
:Expertise rdf:type owl:Class ;
           rdfs:subClassOf :AIoDConcept ;
           rdfs:comment "The area of specialization and practical experience." ;
           rdfs:label "Expertise"@en .


###  http://aiod.eu/data/FundingOpportunity
:FundingOpportunity rdf:type owl:Class ;
                    rdfs:subClassOf :NewsItem ;
                    rdfs:comment "An article highlighting opportunities for financial support." ;
                    rdfs:label "Funding Opportunity"@en .


###  http://aiod.eu/data/Image
:Image rdf:type owl:Class ;
       owl:equivalentClass foaf:Image ;
       rdfs:subClassOf :Multimedia ;
       rdfs:comment "The depiction/visual representation of static elements." ;
       rdfs:label "Image"@en .


###  http://aiod.eu/data/InformationalService
:InformationalService rdf:type owl:Class ;
                      rdfs:subClassOf :Service ;
                      rdfs:label "Informational Service"@en .


###  http://aiod.eu/data/InnovationService
:InnovationService rdf:type owl:Class ;
                   rdfs:subClassOf :Service ;
                   rdfs:label "Innovation Service"@en .


###  http://aiod.eu/data/InvolvementLevel
:InvolvementLevel rdf:type owl:Class ;
                  rdfs:label "Involvement Level"@en .


###  http://aiod.eu/data/JobAnnouncement
:JobAnnouncement rdf:type owl:Class ;
                 rdfs:subClassOf :NewsItem ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :issuer ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Organisation
                                 ] ;
                 rdfs:comment "An article highlighting employment opportunities." ;
                 rdfs:label "Job Announcement"@en ;
                 skos:relatedMatch esco:Occupation ,
                                   org:Post ,
                                   saro:JobPosting .


###  http://aiod.eu/data/KnowledgeAsset
:KnowledgeAsset rdf:type owl:Class ;
                rdfs:subClassOf :AIAsset ;
                rdfs:comment "An AI Asset used as an information item for other entities, such as assets and scientific areas." ;
                rdfs:label "Knowledge Asset"@en .


###  http://aiod.eu/data/Language
:Language rdf:type owl:Class ;
          rdfs:subClassOf :AIoDConcept ;
          rdfs:label "Language"@en .


###  http://aiod.eu/data/LearningMode
:LearningMode rdf:type owl:Class ;
              rdfs:subClassOf :AIoDConcept ;
              rdfs:label "Learning Mode"@en .


###  http://aiod.eu/data/Library
:Library rdf:type owl:Class ;
         rdfs:subClassOf :Distribution ;
         rdfs:label "Library"@en .


###  http://aiod.eu/data/Lidar
:Lidar rdf:type owl:Class ;
       rdfs:subClassOf :Sensor .


###  http://aiod.eu/data/Location
:Location rdf:type owl:Class ;
          owl:equivalentClass dct:Location ;
          rdfs:subClassOf :AIoDConcept ;
          rdfs:comment "A spatial region or named place." ;
          rdfs:label "Location"@en .


###  http://aiod.eu/data/MLModel
:MLModel rdf:type owl:Class ;
         rdfs:subClassOf :Model ;
         rdfs:comment "A model designed  for machine learning tasks." ;
         rdfs:label "ML Model"@en .


###  http://aiod.eu/data/Map
:Map rdf:type owl:Class ;
     rdfs:subClassOf :RobotModel ;
     rdfs:label "Map"@en .


###  http://aiod.eu/data/Memory
:Memory rdf:type owl:Class ;
        rdfs:subClassOf :ComputeComponent ;
        rdfs:comment "A component that stores data temporarily for fast access during processing."@en ;
        rdfs:label "Memory"@en .


###  http://aiod.eu/data/Model
:Model rdf:type owl:Class ;
       rdfs:subClassOf :AIAsset ;
       rdfs:comment "A representation of a system used for prediction or reasoning."@en ;
       rdfs:label "Model"@en .


###  http://aiod.eu/data/Multimedia
:Multimedia rdf:type owl:Class ;
            rdfs:subClassOf :KnowledgeAsset ;
            rdfs:comment "The combination of various media formats." ;
            rdfs:label "Multimedia"@en .


###  http://aiod.eu/data/NetworkMembership
:NetworkMembership rdf:type owl:Class ;
                   rdfs:subClassOf :AIoDConcept ;
                   rdfs:label "Network Membership"@en .


###  http://aiod.eu/data/NewsCategory
:NewsCategory rdf:type owl:Class ;
              rdfs:subClassOf :AIoDConcept ;
              rdfs:comment "A classification label indicating the topic of a news item."@en ;
              rdfs:label "News Category"@en .


###  http://aiod.eu/data/NewsItem
:NewsItem rdf:type owl:Class ;
          rdfs:subClassOf :EcosystemResource ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :headline ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :news_status ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:string
                          ] ;
          rdfs:comment "An article (possible of mixed modality) that reports or summarizes news." ;
          rdfs:label "News Item"@en .


###  http://aiod.eu/data/Notebook
:Notebook rdf:type owl:Class ;
          rdfs:subClassOf :Distribution ;
          rdfs:label "Notebook"@en .


###  http://aiod.eu/data/OpenCallProject
:OpenCallProject rdf:type owl:Class ;
                 rdfs:subClassOf :Project ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :parent_project ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :Project
                                 ] ;
                 rdfs:comment "A project funded in the context of an Open Call process of another project." ;
                 rdfs:label "Open Call Project"@en .


###  http://aiod.eu/data/Operation
:Operation rdf:type owl:Class ;
           rdfs:subClassOf :AIAsset ;
           rdfs:comment "A task or function performed within a system." ;
           rdfs:label "Operation"@en .


###  http://aiod.eu/data/Organisation
:Organisation rdf:type owl:Class ;
              owl:equivalentClass foaf:Organisation ;
              rdfs:subClassOf :Agent ;
              rdfs:comment "An association of people with a specific purpose." ;
              skos:relatedMatch org:FormalOrganization .


###  http://aiod.eu/data/OrganisationActivityType
:OrganisationActivityType rdf:type owl:Class ;
                          rdfs:subClassOf :AIoDConcept ;
                          rdfs:label "Organisation Activity Type"@en .


###  http://aiod.eu/data/OrganisationType
:OrganisationType rdf:type owl:Class ;
                  rdfs:label "Organisation Type"@en .


###  http://aiod.eu/data/OrganisationalNetwork
:OrganisationalNetwork rdf:type owl:Class ;
                       rdfs:subClassOf :Agent .


###  http://aiod.eu/data/Person
:Person rdf:type owl:Class ;
        owl:equivalentClass foaf:Person ;
        rdfs:subClassOf :Agent ;
        rdfs:comment "A human being." .


###  http://aiod.eu/data/PlatformAccount
:PlatformAccount rdf:type owl:Class ;
                 rdfs:subClassOf :AIoDConcept ;
                 rdfs:comment "The account used to access and interact with an online platform."@en ;
                 rdfs:label "Platform Account"@en .


###  http://aiod.eu/data/Presentation
:Presentation rdf:type owl:Class ;
              rdfs:subClassOf :KnowledgeAsset ;
              rdfs:comment "A structured format for communicating information." ;
              rdfs:label "Presentation"@en .


###  http://aiod.eu/data/Problem
:Problem rdf:type owl:Class ;
         rdfs:subClassOf :AIoDConcept ;
         rdfs:comment "The specific issue or challenge." ;
         rdfs:label "Problem"@en .


###  http://aiod.eu/data/Project
:Project rdf:type owl:Class ;
         owl:equivalentClass foaf:Project ;
         rdfs:subClassOf :EcosystemResource ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :coordinator ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Organisation
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :total_cost_euros ;
                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onDataRange xsd:decimal
                         ] ;
         rdfs:comment "A contractually defined initiative aimed to achieve specific objectives." ;
         rdfs:label "Project"@en .


###  http://aiod.eu/data/Protocol
:Protocol rdf:type owl:Class ;
          rdfs:subClassOf :DocumentaryResource ;
          rdfs:label "Protocol"@en .


###  http://aiod.eu/data/Publication
:Publication rdf:type owl:Class ;
             owl:equivalentClass dct:BibliographicResource ;
             rdfs:subClassOf :DocumentaryResource ;
             rdfs:comment "A scientific publication." ;
             rdfs:label "Publication"@en .


###  http://aiod.eu/data/Purpose
:Purpose rdf:type owl:Class ;
         rdfs:subClassOf :AIoDConcept ;
         rdfs:comment "The intended use or objective behind a dataset, AI system, or resource."@en ;
         rdfs:label "Purpose"@en .


###  http://aiod.eu/data/Radar
:Radar rdf:type owl:Class ;
       rdfs:subClassOf :Sensor .


###  http://aiod.eu/data/Requirement
:Requirement rdf:type owl:Class ;
             rdfs:subClassOf :AIoDConcept ;
             rdfs:comment "A necessary condition, constraint, or capability specified for achieving a particular goal or fulfilling a function." ;
             rdfs:label "Requirement"@en .


###  http://aiod.eu/data/ResearchArea
:ResearchArea rdf:type owl:Class ;
              rdfs:subClassOf :Expertise ;
              rdfs:comment "A specific domain within the broader field of AI." ;
              rdfs:label "Research Area"@en .


###  http://aiod.eu/data/ResearchProblem
:ResearchProblem rdf:type owl:Class ;
                 rdfs:subClassOf :Problem ;
                 rdfs:comment "The specific issue or challenge faced in the context of research." ;
                 rdfs:label "Research Problem"@en .


###  http://aiod.eu/data/ResourceBundle
:ResourceBundle rdf:type owl:Class ;
                rdfs:subClassOf :AIResource ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty :includes_resource ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass :AIResource
                                ] ;
                rdfs:comment "A coherent collection of resources intended to be shared as a set." ;
                rdfs:label "Resource Bundle"@en .


###  http://aiod.eu/data/Risk
:Risk rdf:type owl:Class ;
      rdfs:subClassOf :AIoDConcept ;
      rdfs:comment "The possibility of harm or other adverse effects resulting from a given action, process, or condition." ;
      rdfs:label "Risk"@en .


###  http://aiod.eu/data/RobotModel
:RobotModel rdf:type owl:Class ;
            rdfs:subClassOf :Model ;
            rdfs:label "Robot Model"@en .


###  http://aiod.eu/data/RoboticEquipment
:RoboticEquipment rdf:type owl:Class ;
                  rdfs:subClassOf :AIAsset ;
                  rdfs:label "Robotic equipment"@en .


###  http://aiod.eu/data/RunnableDistribution
:RunnableDistribution rdf:type owl:Class ;
                      rdfs:subClassOf :Distribution ;
                      rdfs:label "Runnable Distribution"@en .


###  http://aiod.eu/data/SaaS
:SaaS rdf:type owl:Class ;
      rdfs:subClassOf :Distribution ;
      rdfs:label "SaaS"@en .


###  http://aiod.eu/data/SafetyAndTrustService
:SafetyAndTrustService rdf:type owl:Class ;
                       rdfs:subClassOf :Service ;
                       rdfs:label "Safety and Trust Service"@en .


###  http://aiod.eu/data/ScientificDomain
:ScientificDomain rdf:type owl:Class ;
                  rdfs:subClassOf :Expertise ;
                  rdfs:comment "A field of study within the sciences."@en ;
                  rdfs:label "Scientific Domain"@en .


###  http://aiod.eu/data/Sensor
:Sensor rdf:type owl:Class ;
        rdfs:subClassOf :Device ;
        rdfs:label "Sensor"@en .


###  http://aiod.eu/data/Service
:Service rdf:type owl:Class ;
         rdfs:subClassOf :EcosystemResource ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :provider ;
                           owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                           owl:onClass :Agent
                         ] ;
         rdfs:comment "The provision of functionality to use an asset." ;
         rdfs:label "Service"@en .


