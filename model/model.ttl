###  http://aiod.eu/data/Workflow
:Workflow rdf:type owl:Class ;
          rdfs:subClassOf :AIAsset ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :includes_step ;
                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onClass :WorkflowStep
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :workflow_specification ;
                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                            owl:onDataRange xsd:anyURI
                          ] ;
          rdfs:comment "A structured sequence of processes for the accomplishment of a task." ;
          rdfs:label "Workflow"@en .


###  http://aiod.eu/data/WorkflowExecution
:WorkflowExecution rdf:type owl:Class ;
                   rdfs:subClassOf :AIAsset ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :entails_step ;
                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass :WorkflowExecutionStep
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :workflow_execution_status ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
                   rdfs:comment "The actual conduct of a previously defined workflow." ;
                   rdfs:label "Workflow Execution"@en .


###  http://aiod.eu/data/WorkflowExecutionStep
:WorkflowExecutionStep rdf:type owl:Class ;
                       rdfs:subClassOf :AIAsset ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :includes_operation ;
                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
