@prefix : <http://aiod.eu/data/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix esco: <http://data.europa.eu/esco/model#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saro: <https://w3id.org/saro#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://aiod.eu/data/> .

<http://aiod.eu/data/> rdf:type owl:Ontology ;
                        owl:versionIRI <http://aiod.eu/data/4.0> ;
                        dct:bibliographicCitation "Antonis Koukourikos, Marianna Tsigkou, Costas Spyropoulos. AIoD Metadata Model. Revision: v4.0. "@en ;
                        dct:creator "Antonis Koukourikos, Marianna Tsigkou, Costas Spyropoulos." ;
                        dct:description "AIoD Metadata Model represents concepts and relationships related to AI assets and resources."@en ;
                        dct:issued "2025-03-12"^^xsd:date ;
                        dct:license <https://raw.githubusercontent.com/aiondemand/metadata-schema/main/LICENSE> ;
                        dct:modified "2024-03-12"^^xsd:date ;
                        dct:publisher "Institute of Informatics and Telecommunications (IIT), NCSR Demokritos " ;
                        dct:title "AIoD Metadata Model"@en ;
                        vann:preferredNamespacePrefix "aiod" ;
                        vann:preferredNamespaceUri "http://aiod.eu/data/" ;
                        owl:versionInfo "v4.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/bibliographicCitation
dct:bibliographicCitation rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dct:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dct:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
dct:issued rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dct:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dct:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dct:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dct:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://aiod.eu/data/able_to_perform
:able_to_perform rdf:type owl:ObjectProperty ;
                 rdfs:domain :Actor ;
                 rdfs:range :Actuation ;
                 rdfs:label "able to perform"@en .


###  http://aiod.eu/data/accelerator
:accelerator rdf:type owl:ObjectProperty ;
             rdfs:domain :ComputationalRequirement ;
             rdfs:range :Accelerator ;
             rdfs:comment "Specifies the type of accelerator required."@en ;
             rdfs:label "accelerator"@en .


###  http://aiod.eu/data/address
:address rdf:type owl:ObjectProperty ;
         rdfs:domain :ContactDetails ;
         rdfs:range :Location ;
         rdfs:comment "The postal address associated with the ContactDetails." ;
         rdfs:label "address"@en .


###  http://aiod.eu/data/addresses
:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain :Solution ;
           rdfs:range :Problem ;
           rdfs:comment "Indicates the problem that the solution aims to solve."@en ;
           rdfs:label "addresses"@en .


###  http://aiod.eu/data/aiod_entry
:aiod_entry rdf:type owl:ObjectProperty ;
            rdfs:domain :AIResource ;
            rdfs:range :AIoDEntry ;
            rdfs:comment "Links an AI resource to its corresponding entry in the AIoD catalogue."@en ;
            rdfs:label "aiod entry"@en .


###  http://aiod.eu/data/announced_in
:announced_in rdf:type owl:ObjectProperty ;
              rdfs:domain :SuccessStory ;
              rdfs:range :Announcement ;
              rdfs:comment "The Announcement in which the entity is disclosed." ;
              rdfs:label "announced in"@en .


###  http://aiod.eu/data/applies
:applies rdf:type owl:ObjectProperty ;
         rdfs:domain :AIAsset ;
         rdfs:range :Solution ;
         rdfs:comment "The AIAsset used to implement a Solution." ;
         rdfs:label "applies"@en .


###  http://aiod.eu/data/business_sector
:business_sector rdf:type owl:ObjectProperty ;
                 rdfs:domain :AIResource ;
                 rdfs:range :BusinessSector ;
                 rdfs:comment "An industrial sector where a resource is or can be of use (possibly in the context of a larger framework or initiative)." ;
                 rdfs:label "business sector"@en .


###  http://aiod.eu/data/carries_model
:carries_model rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :RoboticEquipment ;
               rdfs:range :RobotModel ;
               rdfs:label "carries model"@en .


###  http://aiod.eu/data/category
:category rdf:type owl:ObjectProperty ;
          rdfs:domain :NewsItem ;
          rdfs:range :NewsCategory ;
          rdfs:comment "Assigns a news item to a specific news category."@en ;
          rdfs:label "category"@en .


###  http://aiod.eu/data/connected_to
:connected_to rdf:type owl:ObjectProperty ;
              rdfs:domain :WorkflowStep ;
              rdfs:range :WorkflowStep ;
              rdfs:comment "A WorkflowStep is linked to another WorkflowStep." ;
              rdfs:label "connected to"@en .


###  http://aiod.eu/data/contact
:contact rdf:type owl:ObjectProperty ;
         rdfs:domain :AIResource ;
         rdfs:range :Person ;
         rdfs:comment "A contact person for acquiring information on the resource." ;
         rdfs:label "contact"@en .


###  http://aiod.eu/data/contact_info
:contact_info rdf:type owl:ObjectProperty ;
              rdfs:domain :Agent ;
              rdfs:range :ContactDetails ;
              rdfs:comment "Contact information for the agent." ;
              rdfs:label "contact info"@en .


###  http://aiod.eu/data/content
:content rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :AIoDEntry ;
         rdfs:range owl:Thing .


###  http://aiod.eu/data/coordinator
:coordinator rdf:type owl:ObjectProperty ;
             rdfs:domain :Project ;
             rdfs:range :Organisation ;
             rdfs:comment "The coordinating organisation for the project." ;
             rdfs:label "coordinator"@en .


###  http://aiod.eu/data/creator
:creator rdf:type owl:ObjectProperty ;
         rdfs:domain :AIAsset ;
         rdfs:range :Agent ;
         rdfs:comment "An entity responsible for making the AI asset." ;
         rdfs:label "creator"@en .


###  http://aiod.eu/data/current_event_status
:current_event_status rdf:type owl:ObjectProperty ;
                      rdfs:domain :Event ;
                      rdfs:range :EventStatus ;
                      rdfs:label "current event status"@en .


###  http://aiod.eu/data/datasheet
:datasheet rdf:type owl:ObjectProperty ;
           rdfs:domain :Device ;
           rdfs:range :Publication ;
           rdfs:label "datasheet"@en .


###  http://aiod.eu/data/distribution
:distribution rdf:type owl:ObjectProperty ;
              rdfs:domain :AIAsset ;
              rdfs:range :Distribution ;
              rdfs:comment "A Distribution of the AI Asset." ;
              rdfs:label "distribution"@en .


###  http://aiod.eu/data/documented_in
:documented_in rdf:type owl:ObjectProperty ;
               rdfs:domain :AIResource ;
               rdfs:range :KnowledgeAsset ;
               rdfs:comment "A Knowledge Asset describing and documenting the given resource." ;
               rdfs:label "documented in"@en .


###  http://aiod.eu/data/documents
:documents rdf:type owl:ObjectProperty ;
           rdfs:domain :KnowledgeAsset ;
           rdfs:range :AIResource ;
           rdfs:comment "An AI resource for which the Knowledge Asset acts as an information source." ;
           rdfs:label "documents"@en .


###  http://aiod.eu/data/duration
:duration rdf:type owl:ObjectProperty ;
          rdfs:domain :Event ;
          rdfs:range :Size ;
          rdfs:comment "The length of the Event in the unit specified by the associated Size entity." ;
          rdfs:label "duration"@en .


###  http://aiod.eu/data/editor
:editor rdf:type owl:ObjectProperty ;
        rdfs:domain :AIoDEntry ;
        rdfs:range :ContactDetails ;
        rdfs:comment "The person responsible for maintaining the entry." ;
        rdfs:label "editor"@en .


###  http://aiod.eu/data/entails
:entails rdf:type owl:ObjectProperty ;
         rdfs:domain :BusinessSector ;
         rdfs:range :BusinessFunction ;
         rdfs:comment "A Business Sector involves Business Function." ;
         rdfs:label "entails"@en .


###  http://aiod.eu/data/entails_step
:entails_step rdf:type owl:ObjectProperty ;
              rdfs:domain :WorkflowExecution ;
              rdfs:range :WorkflowExecutionStep ;
              rdfs:comment "The Workflow Execution Step that is executed as part of the specific workflow run." ;
              rdfs:label "entails step"@en .


###  http://aiod.eu/data/faces
:faces rdf:type owl:ObjectProperty ;
       rdfs:domain :BusinessFunction ;
       rdfs:range :BusinessProblem ;
       rdfs:comment "The Business Function is challenged by a specific Business Problem." ;
       rdfs:label "faces"@en .


###  http://aiod.eu/data/follows
:follows rdf:type owl:ObjectProperty ;
         rdfs:domain :Operation ;
         rdfs:range :Operation ;
         rdfs:comment "The next Operation in the workflow execution step." ;
         rdfs:label "follows"@en .


###  http://aiod.eu/data/formal_prerequisite
:formal_prerequisite rdf:type owl:ObjectProperty ;
                     rdfs:domain :Course ;
                     rdfs:range :Course ;
                     rdfs:comment "The course a learner must successfully complete before enrolling to another course." ;
                     rdfs:label "formal prerequisite"@en .


###  http://aiod.eu/data/funder
:funder rdf:type owl:ObjectProperty ;
        rdfs:domain [ rdf:type owl:Class ;
                      owl:unionOf ( :Dataset
                                    :FundingOpportunity
                                  )
                    ] ;
        rdfs:range :Agent ;
        rdfs:comment "The Agent responsible for funding the Dataset or associated with the Funding Opportunity" ;
        rdfs:label "funder"@en .


###  http://aiod.eu/data/hardware_requirement
:hardware_requirement rdf:type owl:ObjectProperty ;
                      rdfs:domain :RunnableDistribution ;
                      rdfs:range :ComputationalRequirement ;
                      rdfs:comment "The Computational Requirement that is necessary for the functioning of the Runnable Distribution" ;
                      rdfs:label "hardware requirement"@en .


###  http://aiod.eu/data/has_activity_type
:has_activity_type rdf:type owl:ObjectProperty ;
                   rdfs:domain :Organisation ;
                   rdfs:range :OrganisationActivityType ;
                   rdfs:label "has activity type"@en .


###  http://aiod.eu/data/has_computational_requirement
:has_computational_requirement rdf:type owl:ObjectProperty ;
                               rdfs:domain :Distribution ;
                               rdfs:range :ComputationalRequirement ;
                               rdfs:comment "The ComputationalRequirement needed for the Distribution to function." ;
                               rdfs:label "has computational requiremnt"@en .


###  http://aiod.eu/data/has_cpu
:has_cpu rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :ComputationalAsset
                                     :ComputationalRequirement
                                   )
                     ] ;
         rdfs:range :CPU ;
         rdfs:comment "The CPU used." ;
         rdfs:label "has cpu"@en .


###  http://aiod.eu/data/has_fixed_equipment
:has_fixed_equipment rdf:type owl:ObjectProperty ;
                     rdfs:domain :RoboticEquipment ;
                     rdfs:range :Device ;
                     rdfs:label "has fixed equipment"@en .


###  http://aiod.eu/data/has_membership_in
:has_membership_in rdf:type owl:ObjectProperty ;
                   rdfs:domain :Organisation ;
                   rdfs:range :NetworkMembership ;
                   rdfs:label "has membership in"@en .


###  http://aiod.eu/data/has_optional_equipment
:has_optional_equipment rdf:type owl:ObjectProperty ;
                        rdfs:domain :RoboticEquipment ;
                        rdfs:range :Device ;
                        rdfs:label "has optional equipment"@en .


###  http://aiod.eu/data/has_part
:has_part rdf:type owl:ObjectProperty ;
          owl:inverseOf :part_of ;
          rdfs:domain :AIResource ;
          rdfs:range :AIResource ;
          rdfs:comment "A resource that includes this resource." ;
          rdfs:label "has part"@en .


###  http://aiod.eu/data/has_platform_account
:has_platform_account rdf:type owl:ObjectProperty ;
                      rdfs:domain :Agent ;
                      rdfs:range :PlatformAccount ;
                      rdfs:comment "Indicates the platform account associated with the agent."@en ;
                      rdfs:label "has platform account"@en .


###  http://aiod.eu/data/in_network
:in_network rdf:type owl:ObjectProperty ;
            rdfs:domain :NetworkMembership ;
            rdfs:range :OrganisationalNetwork .


###  http://aiod.eu/data/includes_media
:includes_media rdf:type owl:ObjectProperty ;
                rdfs:domain :NewsItem ;
                rdfs:range :Multimedia ;
                rdfs:comment "Multimedia content included in the news item." ;
                rdfs:label "includes media"@en .


###  http://aiod.eu/data/includes_operation
:includes_operation rdf:type owl:ObjectProperty ;
                    rdfs:domain :WorkflowExecutionStep ;
                    rdfs:range :Operation ;
                    rdfs:comment "The Operation included in the WorkflowExecutionStep." ;
                    rdfs:label "includes operation"@en .


###  http://aiod.eu/data/includes_resource
:includes_resource rdf:type owl:ObjectProperty ;
                   rdfs:domain :ResourceBundle ;
                   rdfs:range :AIResource ;
                   rdfs:comment "An AIResource that constitutes part of the Resource Bundle." ;
                   rdfs:label "includes resource"@en .


###  http://aiod.eu/data/includes_step
:includes_step rdf:type owl:ObjectProperty ;
               rdfs:domain :Workflow ;
               rdfs:range :WorkflowStep ;
               rdfs:comment "The WorkflowSteps that were followed during the execution." ;
               rdfs:label "includes step"@en .


###  http://aiod.eu/data/invoked_by
:invoked_by rdf:type owl:ObjectProperty ;
            rdfs:domain :WorkflowExecutionStep ;
            rdfs:range :AIResource ;
            rdfs:comment "The AIResource responsible for the initiating of the step." ;
            rdfs:label "invoked by"@en .


###  http://aiod.eu/data/involved_in_area
:involved_in_area rdf:type owl:ObjectProperty ;
                  rdfs:domain :Organisation ;
                  rdfs:range :InvolvementLevel ;
                  rdfs:label "involved in area"@en .


###  http://aiod.eu/data/involvement_area
:involvement_area rdf:type owl:ObjectProperty ;
                  rdfs:domain :InvolvementLevel ;
                  rdfs:range :Expertise ;
                  rdfs:label "involvement area"@en .


###  http://aiod.eu/data/issuer
:issuer rdf:type owl:ObjectProperty ;
        rdfs:domain :JobAnnouncement ;
        rdfs:range :Organisation ;
        rdfs:comment "The Organisation posting the job." ;
        rdfs:label "issuer"@en .


###  http://aiod.eu/data/learning_mode
:learning_mode rdf:type owl:ObjectProperty ;
               rdfs:domain :EducationalResource ;
               rdfs:range :LearningMode ;
               rdfs:label "learning mode"@en .


###  http://aiod.eu/data/location
:location rdf:type owl:ObjectProperty ;
          rdfs:domain :AIResource ;
          rdfs:range :Location ;
          rdfs:label "location"@en .


###  http://aiod.eu/data/media
:media rdf:type owl:ObjectProperty ;
       rdfs:domain :AIResource ;
       rdfs:range :Multimedia ;
       rdfs:comment "An image depicting or associated with the resource." ;
       rdfs:label "media"@en .


###  http://aiod.eu/data/member
:member rdf:type owl:ObjectProperty ;
        rdfs:domain :Organisation ;
        rdfs:range :Agent ;
        rdfs:comment "The entity who participates in the Organisation." ;
        rdfs:label "member"@en .


###  http://aiod.eu/data/member_of
:member_of rdf:type owl:ObjectProperty ;
           rdfs:domain :Person ;
           rdfs:range :Organisation ;
           rdfs:comment "The Organisation that a Person affiliates with." ;
           rdfs:label "member of"@en .


###  http://aiod.eu/data/memory
:memory rdf:type owl:ObjectProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Accelerator ,
                    [ rdf:type owl:Class ;
                      owl:unionOf ( :ComputationalAsset
                                    :ComputationalRequirement
                                  )
                    ] ;
        rdfs:range :Memory .


###  http://aiod.eu/data/number_of_employees
:number_of_employees rdf:type owl:ObjectProperty ;
                     rdfs:domain :Organisation ;
                     rdfs:range :CompanySize .


###  http://aiod.eu/data/offered_by
:offered_by rdf:type owl:ObjectProperty ;
            rdfs:domain :EducationalResource ;
            rdfs:range :Organisation ;
            rdfs:comment "The Organisation which offers the Educational Asset." ;
            rdfs:label "offered by"@en .


###  http://aiod.eu/data/organisation_type
:organisation_type rdf:type owl:ObjectProperty ;
                   rdfs:domain :Organisation ;
                   rdfs:range :OrganisationType ;
                   rdfs:label "organisation type"@en .


###  http://aiod.eu/data/organiser
:organiser rdf:type owl:ObjectProperty ;
           rdfs:domain :Event ;
           rdfs:range :Agent ;
           rdfs:comment "The entity organising the Event." ;
           rdfs:label "organiser"@en .


###  http://aiod.eu/data/os_requirement
:os_requirement rdf:type owl:ObjectProperty ;
                rdfs:domain :RunnableDistribution ;
                rdfs:range :ComputationalRequirement ;
                rdfs:comment "The operation system needed for the proper functioning of the Runannble Distribution." ;
                rdfs:label "os requirement"@en .


###  http://aiod.eu/data/other_dependency
:other_dependency rdf:type owl:ObjectProperty ;
                  rdfs:domain :RunnableDistribution ;
                  rdfs:range :AIAsset ;
                  rdfs:label "other dependency"@en .


###  http://aiod.eu/data/parent_project
:parent_project rdf:type owl:ObjectProperty ;
                rdfs:domain :OpenCallProject ;
                rdfs:range :Project ;
                rdfs:comment "The project that organised the Open Call process under which this project was funded." ;
                rdfs:label "parent project"@en .


###  http://aiod.eu/data/part_of
:part_of rdf:type owl:ObjectProperty ;
         rdfs:domain :AIResource ;
         rdfs:range :AIResource ;
         rdfs:comment "A resource that is included as a part/component of this resource." ;
         rdfs:label "part of"@en .


###  http://aiod.eu/data/participant
:participant rdf:type owl:ObjectProperty ;
             rdfs:domain :Project ;
             rdfs:range :Organisation ;
             rdfs:comment "Member organisations of the project." ;
             rdfs:label "participant"@en .


###  http://aiod.eu/data/performer
:performer rdf:type owl:ObjectProperty ;
           rdfs:domain :Event ;
           rdfs:range :Agent ;
           rdfs:comment "The entity participating in the Event." ;
           rdfs:label "performer"@en .


###  http://aiod.eu/data/precedes
:precedes rdf:type owl:ObjectProperty ;
          rdfs:domain :Operation ;
          rdfs:range :Operation ;
          rdfs:comment "The previous Operation in the workflow execution step." ;
          rdfs:label "precedes"@en .


###  http://aiod.eu/data/prerequisite_knowledge
:prerequisite_knowledge rdf:type owl:ObjectProperty ;
                        rdfs:domain :EducationalResource ;
                        rdfs:range :ResearchArea ;
                        rdfs:comment "The Research Area that learners should be familiar with before engaging with the Educational Asset." ;
                        rdfs:label "prerequisite knowledge"@en .


###  http://aiod.eu/data/primary_language
:primary_language rdf:type owl:ObjectProperty ;
                  rdfs:domain :Agent ;
                  rdfs:range :Language ;
                  rdfs:label "Primary Language"@en .


###  http://aiod.eu/data/produced
:produced rdf:type owl:ObjectProperty ;
          rdfs:domain :Project ;
          rdfs:range :AIAsset ;
          rdfs:comment "An AI asset produced in the context of the project." ;
          rdfs:label "produced"@en .


###  http://aiod.eu/data/project_funder
:project_funder rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :Project ;
                rdfs:range :Organisation ;
                rdfs:comment "The funding organisation for the project."@en ;
                rdfs:label "project funder"@en .


###  http://aiod.eu/data/provider
:provider rdf:type owl:ObjectProperty ;
          rdfs:domain :Service ;
          rdfs:range :Agent ;
          rdfs:comment "The entity that provides the Service." ;
          rdfs:label "provider"@en .


###  http://aiod.eu/data/refers_to
:refers_to rdf:type owl:ObjectProperty ;
           rdfs:domain :SuccessStory ;
           rdfs:range :AIResource ;
           rdfs:comment "An AIResource related to the entity." ;
           rdfs:label "refers to"@en .


###  http://aiod.eu/data/related_asset
:related_asset rdf:type owl:ObjectProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Event
                                           :NewsItem
                                         )
                           ] ;
               rdfs:range :AIAsset ;
               rdfs:comment "Indicates an AI Asset that is relevant to or associated with a given Event or News Item." ;
               rdfs:label "related asset"@en .


###  http://aiod.eu/data/related_experiment
:related_experiment rdf:type owl:ObjectProperty ;
                    rdfs:domain :MLModel ;
                    rdfs:range :Experiment ;
                    rdfs:comment "The experiment where the model was used." ;
                    rdfs:label "related experiment"@en .


###  http://aiod.eu/data/related_news
:related_news rdf:type owl:ObjectProperty ;
              rdfs:domain :NewsItem ;
              rdfs:range :NewsItem ;
              rdfs:comment "Other News entities related to this entity." ;
              rdfs:label "related news"@en .


###  http://aiod.eu/data/related_project
:related_project rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Event
                                             :NewsItem
                                           )
                             ] ;
                 rdfs:range :Project ;
                 rdfs:comment "a Project whose activities are relevant to or associated with the given Event or News Item." ;
                 rdfs:label "project"@en .


###  http://aiod.eu/data/requires_competency_level
:requires_competency_level rdf:type owl:ObjectProperty ;
                           rdfs:domain :EducationalResource ;
                           rdfs:range :EducationalCompetency ;
                           rdfs:label "required competency level"@en .


###  http://aiod.eu/data/requires_solution_for
:requires_solution_for rdf:type owl:ObjectProperty ;
                       rdfs:domain :BusinessProblem ;
                       rdfs:range :ResearchProblem ;
                       rdfs:comment "Links a business problem to the research problem it depends on for resolution."@en ;
                       rdfs:label "requires solution for"@en .


###  http://aiod.eu/data/research_area
:research_area rdf:type owl:ObjectProperty ;
               rdfs:domain :AIResource ;
               rdfs:range :ResearchArea ;
               rdfs:comment "A research area under which the research problems remedied by the resource fall." ;
               rdfs:label "research area"@en .


###  http://aiod.eu/data/sameAs
:sameAs rdf:type owl:ObjectProperty ;
        rdfs:domain :AIoDConcept ;
        rdfs:range :AIoDConcept ;
        rdfs:comment "An equivalence relationship between entities." ;
        rdfs:label "same as"@en .


###  http://aiod.eu/data/scientific_domain
:scientific_domain rdf:type owl:ObjectProperty ;
                   rdfs:domain :AIResource ;
                   rdfs:range :ScientificDomain ;
                   rdfs:comment "A scientific domain where the activities, operations or outcomes of the resource are applicable."@en ;
                   rdfs:label "scientific domain"@en .


###  http://aiod.eu/data/showcase
:showcase rdf:type owl:ObjectProperty ;
          rdfs:domain :SuccessStory ;
          rdfs:range :Multimedia ;
          rdfs:comment "The Multimedia that demonstrates the achievements of the SuccessStory." ;
          rdfs:label "showcase"@en .


###  http://aiod.eu/data/size
:size rdf:type owl:ObjectProperty ;
      rdfs:domain :Dataset ;
      rdfs:range :Size ;
      rdfs:comment "The size of the Dataset in the unit specified by the associated Size entity." ;
      rdfs:label "size"@en .


###  http://aiod.eu/data/software_dependency
:software_dependency rdf:type owl:ObjectProperty ;
                     rdfs:domain :RunnableDistribution ;
                     rdfs:range :AIAsset ;
