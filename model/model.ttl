#################################################################
#    Object Properties
#################################################################

###  http://aiod.eu/data/able_to_perform
:able_to_perform rdf:type owl:ObjectProperty ;
                 rdfs:domain :Actor ;
                 rdfs:range :Actuation ;
                 rdfs:label "able to perform"@en .


###  http://aiod.eu/data/accelerator
:accelerator rdf:type owl:ObjectProperty ;
             rdfs:domain :ComputationalRequirement ;
             rdfs:range :Accelerator ;
             rdfs:comment "Specifies the type of accelerator required."@en ;
             rdfs:label "accelerator"@en .


###  http://aiod.eu/data/address
:address rdf:type owl:ObjectProperty ;
         rdfs:domain :ContactDetails ;
         rdfs:range :Location ;
         rdfs:comment "The postal address associated with the ContactDetails." ;
         rdfs:label "address"@en .


###  http://aiod.eu/data/addresses
:addresses rdf:type owl:ObjectProperty ;
           rdfs:domain :Solution ;
           rdfs:range :Problem ;
           rdfs:comment "Indicates the problem that the solution aims to solve."@en ;
           rdfs:label "addresses"@en .


###  http://aiod.eu/data/aiod_entry
:aiod_entry rdf:type owl:ObjectProperty ;
            rdfs:domain :AIResource ;
            rdfs:range :AIoDEntry ;
            rdfs:comment "Links an AI resource to its corresponding entry in the AIoD catalogue."@en ;
            rdfs:label "aiod entry"@en .


###  http://aiod.eu/data/announced_in
:announced_in rdf:type owl:ObjectProperty ;
              rdfs:domain :SuccessStory ;
              rdfs:range :Announcement ;
              rdfs:comment "The Announcement in which the entity is disclosed." ;
              rdfs:label "announced in"@en .


###  http://aiod.eu/data/applies
:applies rdf:type owl:ObjectProperty ;
         rdfs:domain :AIAsset ;
         rdfs:range :Solution ;
         rdfs:comment "The AIAsset used to implement a Solution." ;
         rdfs:label "applies"@en .


###  http://aiod.eu/data/asset
:asset rdf:type owl:ObjectProperty ;
       rdfs:domain [ rdf:type owl:Class ;
                     owl:unionOf ( :Event
                                   :NewsItem
                                 )
                   ] ;
       rdfs:range :AIAsset ;
       rdfs:label "asset"@en .


###  http://aiod.eu/data/business_sector
:business_sector rdf:type owl:ObjectProperty ;
                 rdfs:domain :AIResource ;
                 rdfs:range :BusinessSector ;
                 rdfs:comment "An industrial sector where a resource is or can be of use (possibly in the context of a larger framework or initiative)." ;
                 rdfs:label "business sector"@en .


###  http://aiod.eu/data/carries_model
:carries_model rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :RoboticEquipment ;
               rdfs:range :RobotModel ;
               rdfs:label "carries model"@en .


###  http://aiod.eu/data/category
:category rdf:type owl:ObjectProperty ;
          rdfs:domain :NewsItem ;
          rdfs:range :NewsCategory ;
          rdfs:comment "Assigns a news item to a specific news category."@en ;
          rdfs:label "category"@en .


###  http://aiod.eu/data/connected_to
:connected_to rdf:type owl:ObjectProperty ;
              rdfs:domain :WorkflowStep ;
              rdfs:range :WorkflowStep ;
              rdfs:comment "A WorkflowStep is linked to another WorkflowStep." ;
              rdfs:label "connected to"@en .


###  http://aiod.eu/data/contact
:contact rdf:type owl:ObjectProperty ;
         rdfs:domain :AIResource ;
         rdfs:range :Person ;
         rdfs:comment "A contact person for acquiring information on the resource." ;
         rdfs:label "contact"@en .


###  http://aiod.eu/data/contact_info
:contact_info rdf:type owl:ObjectProperty ;
              rdfs:domain :Agent ;
              rdfs:range :ContactDetails ;
              rdfs:comment "Contact information for the agent." ;
              rdfs:label "contact info"@en .


###  http://aiod.eu/data/coordinator
:coordinator rdf:type owl:ObjectProperty ;
             rdfs:domain :Project ;
             rdfs:range :Organisation ;
             rdfs:comment "The coordinating organisation for the project." ;
             rdfs:label "coordinator"@en .


###  http://aiod.eu/data/cpu
:cpu rdf:type owl:ObjectProperty ;
     rdfs:domain :ComputationalRequirement ;
     rdfs:range :CPU ;
     rdfs:label "cpu"@en .


###  http://aiod.eu/data/creator
:creator rdf:type owl:ObjectProperty ;
         rdfs:domain :AIAsset ;
         rdfs:range :Agent ;
         rdfs:comment "An entity responsible for making the AI asset." ;
         rdfs:label "creator"@en .


###  http://aiod.eu/data/datasheet
:datasheet rdf:type owl:ObjectProperty ;
           rdfs:domain :Device ;
           rdfs:range :Publication ;
           rdfs:label "datasheet"@en .


###  http://aiod.eu/data/distribution
:distribution rdf:type owl:ObjectProperty ;
              rdfs:domain :AIAsset ;
              rdfs:range :Distribution ;
              rdfs:comment "A Distribution of the AI Asset." ;
              rdfs:label "distribution"@en .


###  http://aiod.eu/data/documented_in
:documented_in rdf:type owl:ObjectProperty ;
               rdfs:domain :AIResource ;
               rdfs:range :KnowledgeAsset ;
               rdfs:comment "A Knowledge Asset describing and documenting the given resource." ;
               rdfs:label "documented in"@en .


###  http://aiod.eu/data/documents
:documents rdf:type owl:ObjectProperty ;
           rdfs:domain :KnowledgeAsset ;
           rdfs:range :AIResource ;
           rdfs:comment "An AI resource for which the Knowledge Asset acts as an information source." ;
           rdfs:label "documents"@en .


###  http://aiod.eu/data/duration
:duration rdf:type owl:ObjectProperty ;
          rdfs:domain :Event ;
          rdfs:range :Size ;
          rdfs:comment "The length of the Event in the unit specified by the associated Size entity." ;
          rdfs:label "duration"@en .


###  http://aiod.eu/data/editor
:editor rdf:type owl:ObjectProperty ;
        rdfs:domain :AIoDEntry ;
        rdfs:range :ContactDetails ;
        rdfs:comment "The person responsible for maintaining the entry." ;
        rdfs:label "editor"@en .


###  http://aiod.eu/data/entails
:entails rdf:type owl:ObjectProperty ;
         rdfs:domain :BusinessSector ;
         rdfs:range :BusinessFunction ;
         rdfs:comment "A Business Sector involves Business Function." ;
         rdfs:label "entails"@en .


###  http://aiod.eu/data/entails_step
:entails_step rdf:type owl:ObjectProperty ;
              rdfs:domain :WorkflowExecution ;
              rdfs:range :WorkflowExecutionStep ;
              rdfs:comment "The Workflow Execution Step that is executed as part of the specific workflow run." ;
              rdfs:label "entails step"@en .


###  http://aiod.eu/data/faces
:faces rdf:type owl:ObjectProperty ;
       rdfs:domain :BusinessFunction ;
       rdfs:range :BusinessProblem ;
       rdfs:comment "The Business Function is challenged by a specific Business Problem." ;
       rdfs:label "faces"@en .


###  http://aiod.eu/data/follows
:follows rdf:type owl:ObjectProperty ;
         rdfs:domain :Operation ;
         rdfs:range :Operation ;
         rdfs:comment "The next Operation in the workflow execution step." ;
         rdfs:label "follows"@en .


###  http://aiod.eu/data/formal_prerequisite
:formal_prerequisite rdf:type owl:ObjectProperty ;
                     rdfs:domain :Course ;
                     rdfs:range :Course ;
                     rdfs:comment "The course a learner must successfully complete before enrolling to another course." ;
                     rdfs:label "formal prerequisite"@en .


###  http://aiod.eu/data/funder
:funder rdf:type owl:ObjectProperty ;
        rdfs:domain :Dataset ;
        rdfs:range :Agent ;
        rdfs:comment "The funding organisation for the project." ;
        rdfs:label "funder"@en .


###  http://aiod.eu/data/hardware_requirement
:hardware_requirement rdf:type owl:ObjectProperty ;
                      rdfs:domain :RunnableDistribution ;
                      rdfs:range :ComputationalRequirement ;
                      rdfs:comment "The Computational Requirement that is necessary for the functioning of the Runnable Distribution" ;
                      rdfs:label "hardware requirement"@en .


###  http://aiod.eu/data/has_computational_requirement
:has_computational_requirement rdf:type owl:ObjectProperty ;
                               rdfs:domain :Distribution ;
                               rdfs:range :ComputationalRequirement ;
                               rdfs:comment "The ComputationalRequirement needed for the Distribution to function." ;
                               rdfs:label "has computational requiremnt"@en .


###  http://aiod.eu/data/has_fixed_equipment
:has_fixed_equipment rdf:type owl:ObjectProperty ;
                     rdfs:domain :RoboticEquipment ;
                     rdfs:range :Device ;
                     rdfs:label "has fixed equipment"@en .


###  http://aiod.eu/data/has_optional_equipment
