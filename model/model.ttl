###  http://aiod.eu/data/date_created
:date_created rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :AIAsset ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "The date of creation for the AI asset." ;
              rdfs:label "date created"@en .


###  http://aiod.eu/data/date_founded
:date_founded rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Organisation ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "The date of Organisation's foundation." ;
              rdfs:label "date founded"@en .


###  http://aiod.eu/data/date_modified
:date_modified rdf:type owl:DatatypeProperty ;
               owl:equivalentProperty dct:modified ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain :Distribution ;
               rdfs:range xsd:dateTime ;
               rdfs:comment "The date when the Distribution was modified." ;
               rdfs:label "date motdified"@en .


###  http://aiod.eu/data/date_published
:date_published rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :AIAsset ,
                            [ rdf:type owl:Class ;
                              owl:unionOf ( :AIAsset
                                            :Distribution
                                          )
                            ] ;
                rdfs:range xsd:dateTime ;
                rdfs:comment "The date of publication (broader availability) for the AI asset." ;
                rdfs:label "date published"@en .


###  http://aiod.eu/data/deployment_process
:deployment_process rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :RunnableDistribution ;
                    rdfs:range xsd:string ;
                    rdfs:comment "A description of the procedure involved in deploying the Runnable Distribution." ;
