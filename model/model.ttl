          owl:inverseOf :part_of ;
          rdfs:domain :AIResource ;
          rdfs:range :AIResource ;
          rdfs:comment "A resource that includes this resource." ;
          rdfs:label "has part"@en .


###  http://aiod.eu/data/has_platform_account
