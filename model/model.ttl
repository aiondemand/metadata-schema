@prefix : <http://aiod.eu/data/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://aiod.eu/data/> .

<http://aiod.eu/data/> rdf:type owl:Ontology ;
                        owl:versionIRI <http://aiod.eu/data/4.0> ;
                        dct:bibliographicCitation "Antonis Koukourikos, Marianna Tsigkou, Costas Spyropoulos. AIoD Metadata Model. Revision: v4.0. "@en ;
                        dct:creator "Antonis Koukourikos, Marianna Tsigkou, Costas Spyropoulos." ;
                        dct:description "AIoD Metadata Model represents concepts and relationships related to AI assets and resources."@en ;
                        dct:issued "2025-03-12"^^xsd:date ;
                        dct:license <https://raw.githubusercontent.com/aiondemand/metadata-schema/main/LICENSE> ;
                        dct:modified "2024-03-12"^^xsd:date ;
                        dct:publisher "Institute of Informatics and Telecommunications (IIT), NCSR Demokritos " ;
                        dct:title "AIoD Metadata Model"@en ;
                        vann:preferredNamespacePrefix "aiod" ;
                        vann:preferredNamespaceUri "http://aiod.eu/data/" ;
                        owl:versionInfo "v4.0" .

