@prefix : <http://aiod.eu/data/schemas/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://aiod.eu/data/schemas/> .

<http://aiod.eu/data/schemas/> rdf:type owl:Ontology ;
                                owl:imports <http://www.w3.org/2004/02/skos/core> .

#################################################################
#    Individuals
#################################################################

###  http://aiod.eu/data/schemas/AIAndCopyright
:AIAndCopyright rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                <http://www.w3.org/2004/02/skos/core#notation> "con015"@en ;
                rdfs:label "AI and Copyright"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "The legal and policy issues that arise from the integration and utilisation of artificial intelligence."@en .


###  http://aiod.eu/data/schemas/AIAndEpistemology
:AIAndEpistemology rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ;
                   <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                   <http://www.w3.org/2004/02/skos/core#notation> "con016"@en ;
                   rdfs:label "AI and Epistemology"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "The use of artificial intelligence on supporting Epistemology."@en .


###  http://aiod.eu/data/schemas/AIApplication
:AIApplication rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos/core#Concept> ;
               <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
               <http://www.w3.org/2004/02/skos/core#notation> "con017"@en ;
               rdfs:label "AI Application"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "The use off AI technology for solving problems in industry, business, administration or science in academia."@en .


###  http://aiod.eu/data/schemas/AIBenchmark
:AIBenchmark rdf:type owl:NamedIndividual ,
                      <http://www.w3.org/2004/02/skos/core#Concept> ;
             <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
             <http://www.w3.org/2004/02/skos/core#notation> "con018"@en ;
             rdfs:label "AI Benchmark"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Predefined enviroments and training data to test the performance of AI models and techniques."@en .


###  http://aiod.eu/data/schemas/AICompetition
:AICompetition rdf:type owl:NamedIndividual ,
                        <http://www.w3.org/2004/02/skos/core#Concept> ;
               <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
               <http://www.w3.org/2004/02/skos/core#notation> "con019"@en ;
               rdfs:label "AI Competition"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Specified application enviroments with real data in order different AI approaches compete for the best performance."@en .


###  http://aiod.eu/data/schemas/AIServices
:AIServices rdf:type owl:NamedIndividual ,
                     <http://www.w3.org/2004/02/skos/core#Concept> ;
            <http://www.w3.org/2004/02/skos/core#inScheme> :ResearchArea ;
            <http://www.w3.org/2004/02/skos/core#notation> "con020"@en ;
            rdfs:label "AI Services"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "Any infrastructure, software and platform (e.g., cognitive computing, ML frameworks, bots and virtual assistants, etc.) provided as (serverless) services or applications, possibly in the cloud, which are available off the shelf and executed on demand, reducing the management of 25 complex infrastructures."@en .


###  http://aiod.eu/data/schemas/AISoftwareToolkit
:AISoftwareToolkit rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ;
                   <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                   <http://www.w3.org/2004/02/skos/core#notation> "con021"@en ;
                   rdfs:label "AI Software Toolkit"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "A range of software resources designed to enable developers and researchers to build, deploy and maintain artificial intelligence systems."@en .


###  http://aiod.eu/data/schemas/AITrustworthiness
:AITrustworthiness rdf:type owl:NamedIndividual ,
                            <http://www.w3.org/2004/02/skos/core#Concept> ;
                   <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                   <http://www.w3.org/2004/02/skos/core#notation> "con022"@en ;
                   rdfs:label "AI Trustworthiness"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "An approach to AI development that prioritizes safety, reliability, trust and transparency in order the resulted application, service or system be adopted by the people who interact with it."@en .


###  http://aiod.eu/data/schemas/AccomodationFood
:AccomodationFood rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#Concept> ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :BusinessSector ;
                  <http://www.w3.org/2004/02/skos/core#notation> "con002"@en ;
                  rdfs:label "Accomodation and Food"@en ;
                  rdfs:seeAlso "https://inspire.ec.europa.eu/codelist/EconomicActivityNACEValue/I"^^xsd:anyURI ;
                  <http://www.w3.org/2004/02/skos/core#definition> "This section includes the provision of short-stay accommodation for visitors and other travellers and the provision of complete meals and drinks fit for immediate consumption. The amount and type of supplementary services provided within this section can vary widely."@en .


###  http://aiod.eu/data/schemas/Accountability
:Accountability rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                <http://www.w3.org/2004/02/skos/core#notation> "con003"@en ;
                rdfs:label "Accountability"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A method that requires the development, deployment and utilisation of systems in a manner that facilitates the identification and attribution of responsibility for adverse outcomes to the relevant parties."@en .


###  http://aiod.eu/data/schemas/AccountingAndFinance
:AccountingAndFinance rdf:type owl:NamedIndividual ,
                               <http://www.w3.org/2004/02/skos/core#Concept> ;
                      <http://www.w3.org/2004/02/skos/core#inScheme> :BusinessFunction ;
                      <http://www.w3.org/2004/02/skos/core#notation> "con848"@en ;
                      rdfs:label "Accounting & Finance"@en ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Accounting deals with record-keeping and reporting decisions for your company's finances. Finance helps to analyze all the data to make important decisions about how best to direct the organization."@en .


###  http://aiod.eu/data/schemas/AcousticMonitoring
:AcousticMonitoring rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                    <http://www.w3.org/2004/02/skos/core#notation> "con004"@en ;
                    rdfs:label "Acoustic Monitoring"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Acoustic monitoring is a system that employs sound sensors to detect and analyse sounds and vibrations in the surrounding environment."@en .


###  http://aiod.eu/data/schemas/ActiveLearning
:ActiveLearning rdf:type owl:NamedIndividual ,
                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                <http://www.w3.org/2004/02/skos/core#notation> "con005"@en ;
                rdfs:label "Active Learning"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "A special case of machine learning in which a learning algorithm can interactively query a human user (or some other information source), to label new data points with the desired outputs."@en .


###  http://aiod.eu/data/schemas/ActivityAnalysis
:ActivityAnalysis rdf:type owl:NamedIndividual ,
                           <http://www.w3.org/2004/02/skos/core#Concept> ;
                  <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                  <http://www.w3.org/2004/02/skos/core#notation> "con006"@en ;
                  rdfs:label "Activity Analysis"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "The process of analysing video or sequence data with the objective of detecting, recognising and interpreting human activities or behaviours."@en .


###  http://aiod.eu/data/schemas/AdditiveManufacturing
:AdditiveManufacturing rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos/core#Concept> ;
                       <http://www.w3.org/2004/02/skos/core#inScheme> :BusinessProblem ;
                       <http://www.w3.org/2004/02/skos/core#notation> "con007"@en ;
                       rdfs:label "Additive Manufacturing"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Problems in the design and construction/creation of a 3D object following alternative and/or additive approaches through a CAD model or a 3D model."@en .


###  http://aiod.eu/data/schemas/AdversarialAttacks
:AdversarialAttacks rdf:type owl:NamedIndividual ,
                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                    <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ;
                    <http://www.w3.org/2004/02/skos/core#notation> "con008"@en ;
                    rdfs:label "Adversarial Attacks"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A methodology for the generation of adversarial examples."@en .


###  http://aiod.eu/data/schemas/AdversarialMachineLearning
:AdversarialMachineLearning rdf:type owl:NamedIndividual ,
                                     <http://www.w3.org/2004/02/skos/core#Concept> ;
                            <http://www.w3.org/2004/02/skos/core#broader> :MachineLearning ;
                            <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ,
                                                                           :ResearchArea ;
                            <http://www.w3.org/2004/02/skos/core#notation> "con009"@en ;
                            rdfs:label "Adversarial Machine Learning"@en ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Adversarial machine learning is the study of the attacks on machine learning algorithms, and of the defenses against such attacks."@en .


