                    rdfs:label "Refinement Planning"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A process where the user adjusts or rephrases their prompt to obtain a more accurate or relevant response from the AI Assistant."@en .


###  http://aiod.eu/data/schemas/ReinforcementLearning
:ReinforcementLearning rdf:type owl:NamedIndividual ,
                                <http://www.w3.org/2004/02/skos/core#Concept> ;
                       <http://www.w3.org/2004/02/skos/core#broader> :MachineLearning ;
                       <http://www.w3.org/2004/02/skos/core#inScheme> :Approach ,
                                                                      :ResearchArea ;
