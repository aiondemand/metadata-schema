###  http://aiod.eu/data/schemas/ArtsEntertainmentAndRecreation
:ArtsEntertainmentAndRecreation rdf:type owl:NamedIndividual ,
                                         <http://www.w3.org/2004/02/skos/core#Concept> ;
                                <http://www.w3.org/2004/02/skos/core#inScheme> :BusinessSector ;
