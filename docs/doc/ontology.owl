        <rdfs:comment>The URL need for executing a specific step.</rdfs:comment>
        <rdfs:label xml:lang="en">uses input</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/value -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/value">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Size"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>The numerical value representig the Size.</rdfs:comment>
        <rdfs:label xml:lang="en">value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/variable_measured -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/variable_measured">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Dataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The variable that this dataset measures. For example, “temperature” or “pressure”.</rdfs:comment>
        <rdfs:label xml:lang="en">variable measured</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/vendor -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/vendor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://aiod.eu/data/Accelerator"/>
                    <rdf:Description rdf:about="http://aiod.eu/data/CPU"/>
                    <rdf:Description rdf:about="http://aiod.eu/data/Storage"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Vendor name of the CPU, Accelerator, or Storage.</rdfs:comment>
        <rdfs:label xml:lang="en">vendor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/version -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/version">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/width_px -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/width_px">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/Image"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>The width of an Image in pixels.</rdfs:comment>
        <rdfs:label xml:lang="en">width px</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/with_network_role -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/with_network_role">
        <rdfs:domain rdf:resource="http://aiod.eu/data/NetworkMembership"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/workflow_configuration -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/workflow_configuration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/Workflow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>The URL pointing to the configuration document with the settings used.</rdfs:comment>
        <rdfs:label xml:lang="en">workflow configuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/workflow_configuration_standard -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/workflow_configuration_standard">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/Workflow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A description of the guidelines used for setting up the parameters of the workflow.</rdfs:comment>
        <rdfs:label xml:lang="en">workflow configuration standard</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/workflow_execution_status -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/workflow_execution_status">
        <rdfs:domain rdf:resource="http://aiod.eu/data/WorkflowExecution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The current execution status of the workflow.</rdfs:comment>
        <rdfs:label xml:lang="en">workflow execution status</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/workflow_specification -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/workflow_specification">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Workflow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment>The URL where the definitive specification document can be accessed.</rdfs:comment>
        <rdfs:label xml:lang="en">workflow specification</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/workflow_specification_standard -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/workflow_specification_standard">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/Workflow"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>A description of the guidelines used to define the procces tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">workflow specification standard</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/workflow_step_type -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/workflow_step_type">
        <rdfs:domain rdf:resource="http://aiod.eu/data/WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">workflow step type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://aiod.eu/data/write_bandwidth -->


    <owl:DatatypeProperty rdf:about="http://aiod.eu/data/write_bandwidth">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://aiod.eu/data/Memory"/>
                    <rdf:Description rdf:about="http://aiod.eu/data/Storage"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The write bandwidth of the Memory or Storage component.</rdfs:comment>
        <rdfs:label xml:lang="en">write bandwidth</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://aiod.eu/data/AIAsset -->


    <owl:Class rdf:about="http://aiod.eu/data/AIAsset">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:comment>An accessible and usable asset pertaining to AI research and applications.</rdfs:comment>
        <rdfs:label xml:lang="en">AI Asset</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/AIResource -->


    <owl:Class rdf:about="http://aiod.eu/data/AIResource">
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/aiod_entry"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/AIoDEntry"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/media"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Multimedia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/name"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A source of information, guidance or research and development assets for AI.</rdfs:comment>
        <rdfs:label xml:lang="en">AI Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/AIoDConcept -->


    <owl:Class rdf:about="http://aiod.eu/data/AIoDConcept">
        <rdfs:comment>The top level entity of the model.</rdfs:comment>
        <rdfs:label xml:lang="en">AIoD Concept</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/AIoDEntry -->


    <owl:Class rdf:about="http://aiod.eu/data/AIoDEntry">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/editor"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/ContactDetails"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/status"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The entity defines metadata properties pertaining to AIoD platform-specific characteristics of a resource.</rdfs:comment>
        <rdfs:label xml:lang="en">AIoD Entry</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Accelerator -->


    <owl:Class rdf:about="http://aiod.eu/data/Accelerator">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/ComputeComponent"/>
        <rdfs:comment>The part of a computing system responsible for accelerating specific computational tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">Accelerator</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Actor -->


    <owl:Class rdf:about="http://aiod.eu/data/Actor">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Device"/>
        <rdfs:label xml:lang="en">Actor</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Actuation -->


    <owl:Class rdf:about="http://aiod.eu/data/Actuation">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Actuation</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Agent -->


    <owl:Class rdf:about="http://aiod.eu/data/Agent">
        <owl:equivalentClass rdf:resource="http://purl.org/dc/terms/Agent"/>
        <owl:equivalentClass rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/EcosystemResource"/>
        <rdfs:comment>The direct performer or driver of the action (animate or inanimate).</rdfs:comment>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Announcement -->


    <owl:Class rdf:about="http://aiod.eu/data/Announcement">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/NewsItem"/>
        <rdfs:comment>An article containing official information or updates.</rdfs:comment>
        <rdfs:label xml:lang="en">Announcement</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Approach -->


    <owl:Class rdf:about="http://aiod.eu/data/Approach">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>The specific point of view employed to implement a solution.</rdfs:comment>
        <rdfs:label xml:lang="en">Approach</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Assessment -->


    <owl:Class rdf:about="http://aiod.eu/data/Assessment">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>A systematic process of analysis used to determine characteristics, performance, or compliance of an entity, system, or condition.</rdfs:comment>
        <rdfs:label xml:lang="en">Assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Audio -->


    <owl:Class rdf:about="http://aiod.eu/data/Audio">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Multimedia"/>
        <rdfs:comment>A recorded sound.</rdfs:comment>
        <rdfs:label xml:lang="en">Audio</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/BusinessFunction -->


    <owl:Class rdf:about="http://aiod.eu/data/BusinessFunction">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/EcosystemResource"/>
        <rdfs:comment>The area of operations within a business.</rdfs:comment>
        <rdfs:label xml:lang="en">Business Function</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/BusinessProblem -->


    <owl:Class rdf:about="http://aiod.eu/data/BusinessProblem">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Problem"/>
        <rdfs:comment>The specific issue or challenge faced by a company.</rdfs:comment>
        <rdfs:label xml:lang="en">Business Problem</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/BusinessSector -->


    <owl:Class rdf:about="http://aiod.eu/data/BusinessSector">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Expertise"/>
        <rdfs:comment>The distinct subset of the economy.</rdfs:comment>
        <rdfs:label xml:lang="en">Business Sector</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/CPU -->


    <owl:Class rdf:about="http://aiod.eu/data/CPU">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/ComputeComponent"/>
        <rdfs:comment>The central processor of a computer system.</rdfs:comment>
        <rdfs:label xml:lang="en">CPU</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Camera -->


    <owl:Class rdf:about="http://aiod.eu/data/Camera">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Sensor"/>
    </owl:Class>
    


    <!-- http://aiod.eu/data/CaseStudy -->


    <owl:Class rdf:about="http://aiod.eu/data/CaseStudy">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Project"/>
        <rdfs:comment>A contractually defined initiative aimed to achieve specific objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Case Study</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Challenge -->


    <owl:Class rdf:about="http://aiod.eu/data/Challenge">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Project"/>
        <rdfs:comment>A competitive initiative aimed to achieve specific objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Challenge</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Classification -->


    <owl:Class rdf:about="http://aiod.eu/data/Classification">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/classification_id"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/classification_scheme"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A means to categorize entities under classification schemes.</rdfs:comment>
        <rdfs:label xml:lang="en">Classification</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/CloudComputeAsset -->


    <owl:Class rdf:about="http://aiod.eu/data/CloudComputeAsset">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/ComputationalAsset"/>
        <rdfs:label xml:lang="en">Cloud Compute Asset</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/CompanyRevenue -->


