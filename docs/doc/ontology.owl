        <rdfs:label xml:lang="en">Computational Asset</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ComputationalRequirement -->


    <owl:Class rdf:about="http://aiod.eu/data/ComputationalRequirement">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>The computing resources required to perform a function.</rdfs:comment>
        <rdfs:label xml:lang="en">Computational Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ComputeAsset -->


    <owl:Class rdf:about="http://aiod.eu/data/ComputeAsset">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/ComputationalAsset"/>
        <rdfs:label xml:lang="en">Compute Asset</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ComputeComponent -->


    <owl:Class rdf:about="http://aiod.eu/data/ComputeComponent">
