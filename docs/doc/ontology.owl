        <rdfs:comment xml:lang="en">The classification of a company based on the number of employees it has.</rdfs:comment>
        <rdfs:label xml:lang="en">Company Size</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ComputationalAsset -->


    <owl:Class rdf:about="http://aiod.eu/data/ComputationalAsset">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIAsset"/>
