        <rdfs:label xml:lang="en">Course</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/DataDownload -->


    <owl:Class rdf:about="http://aiod.eu/data/DataDownload">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Distribution"/>
