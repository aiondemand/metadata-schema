<?xml version="1.0"?>
<rdf:RDF xmlns="http://aiod.eu/data/"
     xml:base="http://aiod.eu/data/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://aiod.eu/data/">
        <owl:versionIRI rdf:resource="http://aiod.eu/data/4.0"/>
        <terms:bibliographicCitation xml:lang="en">Antonis Koukourikos, Marianna Tsigkou, Costas Spyropoulos. AIoD Metadata Model. Revision: v4.0. </terms:bibliographicCitation>
        <terms:creator>Antonis Koukourikos, Marianna Tsigkou, Costas Spyropoulos.</terms:creator>
        <terms:description xml:lang="en">AIoD Metadata Model represents concepts and relationships related to AI assets and resources.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-12</terms:issued>
        <terms:license rdf:resource="https://raw.githubusercontent.com/aiondemand/metadata-schema/main/LICENSE"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-03-12</terms:modified>
        <terms:publisher>Institute of Informatics and Telecommunications (IIT), NCSR Demokritos </terms:publisher>
        <terms:title xml:lang="en">AIoD Metadata Model</terms:title>
        <vann:preferredNamespacePrefix>aiod</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://aiod.eu/data/</vann:preferredNamespaceUri>
        <owl:versionInfo>v4.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#relatedMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#relatedMatch"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://aiod.eu/data/able_to_perform -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/able_to_perform">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Actor"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Actuation"/>
        <rdfs:label xml:lang="en">able to perform</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/accelerator -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/accelerator">
        <rdfs:domain rdf:resource="http://aiod.eu/data/ComputationalRequirement"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Accelerator"/>
        <rdfs:comment xml:lang="en">Specifies the type of accelerator required.</rdfs:comment>
        <rdfs:label xml:lang="en">accelerator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/address -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/address">
        <rdfs:domain rdf:resource="http://aiod.eu/data/ContactDetails"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Location"/>
        <rdfs:comment>The postal address associated with the ContactDetails.</rdfs:comment>
        <rdfs:label xml:lang="en">address</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/addresses -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/addresses">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Solution"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Problem"/>
        <rdfs:comment xml:lang="en">Indicates the problem that the solution aims to solve.</rdfs:comment>
        <rdfs:label xml:lang="en">addresses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/aiod_entry -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/aiod_entry">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/AIoDEntry"/>
        <rdfs:comment xml:lang="en">Links an AI resource to its corresponding entry in the AIoD catalogue.</rdfs:comment>
        <rdfs:label xml:lang="en">aiod entry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/announced_in -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/announced_in">
        <rdfs:domain rdf:resource="http://aiod.eu/data/SuccessStory"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Announcement"/>
        <rdfs:comment>The Announcement in which the entity is disclosed.</rdfs:comment>
        <rdfs:label xml:lang="en">announced in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/applies -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/applies">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Solution"/>
        <rdfs:comment>The AIAsset used to implement a Solution.</rdfs:comment>
        <rdfs:label xml:lang="en">applies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/business_sector -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/business_sector">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/BusinessSector"/>
        <rdfs:comment>An industrial sector where a resource is or can be of use (possibly in the context of a larger framework or initiative).</rdfs:comment>
        <rdfs:label xml:lang="en">business sector</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/carries_model -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/carries_model">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/RoboticEquipment"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/RobotModel"/>
        <rdfs:label xml:lang="en">carries model</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/category -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/category">
        <rdfs:domain rdf:resource="http://aiod.eu/data/NewsItem"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/NewsCategory"/>
        <rdfs:comment xml:lang="en">Assigns a news item to a specific news category.</rdfs:comment>
        <rdfs:label xml:lang="en">category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/connected_to -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/connected_to">
        <rdfs:domain rdf:resource="http://aiod.eu/data/WorkflowStep"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/WorkflowStep"/>
        <rdfs:comment>A WorkflowStep is linked to another WorkflowStep.</rdfs:comment>
        <rdfs:label xml:lang="en">connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/contact -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/contact">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Person"/>
        <rdfs:comment>A contact person for acquiring information on the resource.</rdfs:comment>
        <rdfs:label xml:lang="en">contact</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/contact_info -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/contact_info">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Agent"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/ContactDetails"/>
        <rdfs:comment>Contact information for the agent.</rdfs:comment>
        <rdfs:label xml:lang="en">contact info</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/content -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/content">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIoDEntry"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/coordinator -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/coordinator">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Project"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Organisation"/>
        <rdfs:comment>The coordinating organisation for the project.</rdfs:comment>
        <rdfs:label xml:lang="en">coordinator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/creator -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/creator">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Agent"/>
        <rdfs:comment>An entity responsible for making the AI asset.</rdfs:comment>
        <rdfs:label xml:lang="en">creator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/current_event_status -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/current_event_status">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Event"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/EventStatus"/>
        <rdfs:label xml:lang="en">current event status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/datasheet -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/datasheet">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Device"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Publication"/>
        <rdfs:label xml:lang="en">datasheet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/distribution -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/distribution">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Distribution"/>
        <rdfs:comment>A Distribution of the AI Asset.</rdfs:comment>
        <rdfs:label xml:lang="en">distribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/documented_in -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/documented_in">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/KnowledgeAsset"/>
        <rdfs:comment>A Knowledge Asset describing and documenting the given resource.</rdfs:comment>
        <rdfs:label xml:lang="en">documented in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/documents -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/documents">
        <rdfs:domain rdf:resource="http://aiod.eu/data/KnowledgeAsset"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:comment>An AI resource for which the Knowledge Asset acts as an information source.</rdfs:comment>
        <rdfs:label xml:lang="en">documents</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/duration -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/duration">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Event"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Size"/>
        <rdfs:comment>The length of the Event in the unit specified by the associated Size entity.</rdfs:comment>
        <rdfs:label xml:lang="en">duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/editor -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/editor">
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIoDEntry"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/ContactDetails"/>
        <rdfs:comment>The person responsible for maintaining the entry.</rdfs:comment>
        <rdfs:label xml:lang="en">editor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/entails -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/entails">
        <rdfs:domain rdf:resource="http://aiod.eu/data/BusinessSector"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/BusinessFunction"/>
        <rdfs:comment>A Business Sector involves Business Function.</rdfs:comment>
        <rdfs:label xml:lang="en">entails</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/entails_step -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/entails_step">
        <rdfs:domain rdf:resource="http://aiod.eu/data/WorkflowExecution"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/WorkflowExecutionStep"/>
        <rdfs:comment>The Workflow Execution Step that is executed as part of the specific workflow run.</rdfs:comment>
        <rdfs:label xml:lang="en">entails step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/faces -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/faces">
        <rdfs:domain rdf:resource="http://aiod.eu/data/BusinessFunction"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/BusinessProblem"/>
        <rdfs:comment>The Business Function is challenged by a specific Business Problem.</rdfs:comment>
        <rdfs:label xml:lang="en">faces</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/follows -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/follows">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Operation"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Operation"/>
        <rdfs:comment>The next Operation in the workflow execution step.</rdfs:comment>
        <rdfs:label xml:lang="en">follows</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/formal_prerequisite -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/formal_prerequisite">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Course"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Course"/>
        <rdfs:comment>The course a learner must successfully complete before enrolling to another course.</rdfs:comment>
        <rdfs:label xml:lang="en">formal prerequisite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/funder -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/funder">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://aiod.eu/data/Dataset"/>
                    <rdf:Description rdf:about="http://aiod.eu/data/FundingOpportunity"/>
                    <rdf:Description rdf:about="http://aiod.eu/data/Project"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://aiod.eu/data/Agent"/>
        <rdfs:comment>The Agent responsible for funding the Dataset or associated with the Funding Opportunity</rdfs:comment>
        <rdfs:label xml:lang="en">funder</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/hardware_requirement -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/hardware_requirement">
        <rdfs:domain rdf:resource="http://aiod.eu/data/RunnableDistribution"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/ComputationalRequirement"/>
        <rdfs:comment>The Computational Requirement that is necessary for the functioning of the Runnable Distribution</rdfs:comment>
        <rdfs:label xml:lang="en">hardware requirement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_activity_type -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_activity_type">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Organisation"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/OrganisationActivityType"/>
        <rdfs:label xml:lang="en">has activity type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_computational_requirement -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_computational_requirement">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Distribution"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/ComputationalRequirement"/>
        <rdfs:comment>The ComputationalRequirement needed for the Distribution to function.</rdfs:comment>
        <rdfs:label xml:lang="en">has computational requiremnt</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_cpu -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_cpu">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://aiod.eu/data/ComputationalAsset"/>
                    <rdf:Description rdf:about="http://aiod.eu/data/ComputationalRequirement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://aiod.eu/data/CPU"/>
        <rdfs:comment>The CPU used.</rdfs:comment>
        <rdfs:label xml:lang="en">has cpu</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_fixed_equipment -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_fixed_equipment">
        <rdfs:domain rdf:resource="http://aiod.eu/data/RoboticEquipment"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Device"/>
        <rdfs:label xml:lang="en">has fixed equipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_membership_in -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_membership_in">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Organisation"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/NetworkMembership"/>
        <rdfs:label xml:lang="en">has membership in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_optional_equipment -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_optional_equipment">
        <rdfs:domain rdf:resource="http://aiod.eu/data/RoboticEquipment"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Device"/>
        <rdfs:label xml:lang="en">has optional equipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_part -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_part">
        <owl:inverseOf rdf:resource="http://aiod.eu/data/part_of"/>
        <rdfs:domain rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:comment>A resource that includes this resource.</rdfs:comment>
        <rdfs:label xml:lang="en">has part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/has_platform_account -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/has_platform_account">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Agent"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/PlatformAccount"/>
        <rdfs:comment xml:lang="en">Indicates the platform account associated with the agent.</rdfs:comment>
        <rdfs:label xml:lang="en">has platform account</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/in_network -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/in_network">
        <rdfs:domain rdf:resource="http://aiod.eu/data/NetworkMembership"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/OrganisationalNetwork"/>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/includes_media -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/includes_media">
        <rdfs:domain rdf:resource="http://aiod.eu/data/NewsItem"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Multimedia"/>
        <rdfs:comment>Multimedia content included in the news item.</rdfs:comment>
        <rdfs:label xml:lang="en">includes media</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/includes_operation -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/includes_operation">
        <rdfs:domain rdf:resource="http://aiod.eu/data/WorkflowExecutionStep"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/Operation"/>
        <rdfs:comment>The Operation included in the WorkflowExecutionStep.</rdfs:comment>
        <rdfs:label xml:lang="en">includes operation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/includes_resource -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/includes_resource">
        <rdfs:domain rdf:resource="http://aiod.eu/data/ResourceBundle"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:comment>An AIResource that constitutes part of the Resource Bundle.</rdfs:comment>
        <rdfs:label xml:lang="en">includes resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/includes_step -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/includes_step">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Workflow"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/WorkflowStep"/>
        <rdfs:comment>The WorkflowSteps that were followed during the execution.</rdfs:comment>
        <rdfs:label xml:lang="en">includes step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/invoked_by -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/invoked_by">
        <rdfs:domain rdf:resource="http://aiod.eu/data/WorkflowExecutionStep"/>
        <rdfs:range rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:comment>The AIResource responsible for the initiating of the step.</rdfs:comment>
        <rdfs:label xml:lang="en">invoked by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://aiod.eu/data/involved_in_area -->


    <owl:ObjectProperty rdf:about="http://aiod.eu/data/involved_in_area">
        <rdfs:domain rdf:resource="http://aiod.eu/data/Organisation"/>
