        <rdfs:label xml:lang="en">Learning Mode</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Library -->


    <owl:Class rdf:about="http://aiod.eu/data/Library">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Distribution"/>
        <rdfs:label xml:lang="en">Library</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Lidar -->


    <owl:Class rdf:about="http://aiod.eu/data/Lidar">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Sensor"/>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Location -->


    <owl:Class rdf:about="http://aiod.eu/data/Location">
        <owl:equivalentClass rdf:resource="http://purl.org/dc/terms/Location"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>A spatial region or named place.</rdfs:comment>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/MLModel -->


    <owl:Class rdf:about="http://aiod.eu/data/MLModel">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Model"/>
        <rdfs:comment>A model designed  for machine learning tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">ML Model</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Map -->


    <owl:Class rdf:about="http://aiod.eu/data/Map">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/RobotModel"/>
        <rdfs:label xml:lang="en">Map</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Memory -->


    <owl:Class rdf:about="http://aiod.eu/data/Memory">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/ComputeComponent"/>
        <rdfs:comment xml:lang="en">A component that stores data temporarily for fast access during processing.</rdfs:comment>
        <rdfs:label xml:lang="en">Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Model -->


    <owl:Class rdf:about="http://aiod.eu/data/Model">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:comment xml:lang="en">A representation of a system used for prediction or reasoning.</rdfs:comment>
        <rdfs:label xml:lang="en">Model</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Multimedia -->


    <owl:Class rdf:about="http://aiod.eu/data/Multimedia">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/KnowledgeAsset"/>
        <rdfs:comment>The combination of various media formats.</rdfs:comment>
        <rdfs:label xml:lang="en">Multimedia</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/NetworkMembership -->


    <owl:Class rdf:about="http://aiod.eu/data/NetworkMembership">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Network Membership</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/NewsCategory -->


    <owl:Class rdf:about="http://aiod.eu/data/NewsCategory">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment xml:lang="en">A classification label indicating the topic of a news item.</rdfs:comment>
        <rdfs:label xml:lang="en">News Category</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/NewsItem -->


    <owl:Class rdf:about="http://aiod.eu/data/NewsItem">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/EcosystemResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/headline"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/news_status"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An article (possible of mixed modality) that reports or summarizes news.</rdfs:comment>
        <rdfs:label xml:lang="en">News Item</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Notebook -->


    <owl:Class rdf:about="http://aiod.eu/data/Notebook">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Distribution"/>
        <rdfs:label xml:lang="en">Notebook</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/OpenCallProject -->


    <owl:Class rdf:about="http://aiod.eu/data/OpenCallProject">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Project"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/parent_project"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Project"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A project funded in the context of an Open Call process of another project.</rdfs:comment>
        <rdfs:label xml:lang="en">Open Call Project</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Operation -->


    <owl:Class rdf:about="http://aiod.eu/data/Operation">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:comment>A task or function performed within a system.</rdfs:comment>
        <rdfs:label xml:lang="en">Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Organisation -->


    <owl:Class rdf:about="http://aiod.eu/data/Organisation">
        <owl:equivalentClass rdf:resource="http://xmlns.com/foaf/0.1/Organisation"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Agent"/>
        <rdfs:comment>An association of people with a specific purpose.</rdfs:comment>
        <skos:relatedMatch rdf:resource="http://www.w3.org/ns/org#FormalOrganization"/>
    </owl:Class>
    


    <!-- http://aiod.eu/data/OrganisationActivityType -->


    <owl:Class rdf:about="http://aiod.eu/data/OrganisationActivityType">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Organisation Activity Type</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/OrganisationType -->


    <owl:Class rdf:about="http://aiod.eu/data/OrganisationType">
        <rdfs:label xml:lang="en">Organisation Type</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/OrganisationalNetwork -->


    <owl:Class rdf:about="http://aiod.eu/data/OrganisationalNetwork">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Agent"/>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Person -->


    <owl:Class rdf:about="http://aiod.eu/data/Person">
        <owl:equivalentClass rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Agent"/>
        <rdfs:comment>A human being.</rdfs:comment>
    </owl:Class>
    


    <!-- http://aiod.eu/data/PlatformAccount -->


    <owl:Class rdf:about="http://aiod.eu/data/PlatformAccount">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment xml:lang="en">The account used to access and interact with an online platform.</rdfs:comment>
        <rdfs:label xml:lang="en">Platform Account</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Presentation -->


    <owl:Class rdf:about="http://aiod.eu/data/Presentation">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/KnowledgeAsset"/>
        <rdfs:comment>A structured format for communicating information.</rdfs:comment>
        <rdfs:label xml:lang="en">Presentation</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Problem -->


    <owl:Class rdf:about="http://aiod.eu/data/Problem">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>The specific issue or challenge.</rdfs:comment>
        <rdfs:label xml:lang="en">Problem</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Project -->


    <owl:Class rdf:about="http://aiod.eu/data/Project">
        <owl:equivalentClass rdf:resource="http://xmlns.com/foaf/0.1/Project"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/EcosystemResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/coordinator"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Organisation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/total_cost_euros"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A contractually defined initiative aimed to achieve specific objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Project</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Protocol -->


    <owl:Class rdf:about="http://aiod.eu/data/Protocol">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/DocumentaryResource"/>
        <rdfs:label xml:lang="en">Protocol</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Publication -->


    <owl:Class rdf:about="http://aiod.eu/data/Publication">
        <owl:equivalentClass rdf:resource="http://purl.org/dc/terms/BibliographicResource"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/DocumentaryResource"/>
        <rdfs:comment>A scientific publication.</rdfs:comment>
        <rdfs:label xml:lang="en">Publication</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Purpose -->


    <owl:Class rdf:about="http://aiod.eu/data/Purpose">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment xml:lang="en">The intended use or objective behind a dataset, AI system, or resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Purpose</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Radar -->


    <owl:Class rdf:about="http://aiod.eu/data/Radar">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Sensor"/>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Requirement -->


    <owl:Class rdf:about="http://aiod.eu/data/Requirement">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>A necessary condition, constraint, or capability specified for achieving a particular goal or fulfilling a function.</rdfs:comment>
        <rdfs:label xml:lang="en">Requirement</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ResearchArea -->


    <owl:Class rdf:about="http://aiod.eu/data/ResearchArea">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Expertise"/>
        <rdfs:comment>A specific domain within the broader field of AI.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Area</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ResearchProblem -->


    <owl:Class rdf:about="http://aiod.eu/data/ResearchProblem">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Problem"/>
        <rdfs:comment>The specific issue or challenge faced in the context of research.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Problem</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ResourceBundle -->


    <owl:Class rdf:about="http://aiod.eu/data/ResourceBundle">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:subClassOf>
