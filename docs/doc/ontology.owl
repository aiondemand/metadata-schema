    <!-- http://aiod.eu/data/DataModel -->


    <owl:Class rdf:about="http://aiod.eu/data/DataModel">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Model"/>
        <rdfs:comment xml:lang="en">A structured way to organize and relate data.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Model</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/DataService -->


    <owl:Class rdf:about="http://aiod.eu/data/DataService">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Distribution"/>
        <rdfs:label xml:lang="en">Data Service</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Dataset -->


    <owl:Class rdf:about="http://aiod.eu/data/Dataset">
        <owl:equivalentClass rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/size"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Size"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/spatial_coverage"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A collection of data, published or curated by a specific agency.</rdfs:comment>
        <rdfs:label xml:lang="en">Dataset</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/DeveloperService -->


    <owl:Class rdf:about="http://aiod.eu/data/DeveloperService">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Service"/>
        <rdfs:label xml:lang="en">Developer Service</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Device -->


    <owl:Class rdf:about="http://aiod.eu/data/Device">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment xml:lang="en">An artifact whose purpose is to serve as an instrument in a specific subclass of a process.</rdfs:comment>
        <rdfs:label xml:lang="en">Device</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Distribution -->


    <owl:Class rdf:about="http://aiod.eu/data/Distribution">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/has_computational_requirement"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/ComputationalRequirement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/content_url"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A specific form of packaging and means of distributing an AI Asset.</rdfs:comment>
        <rdfs:label xml:lang="en">Distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/DocumentaryResource -->


    <owl:Class rdf:about="http://aiod.eu/data/DocumentaryResource">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/KnowledgeAsset"/>
        <rdfs:comment xml:lang="en">A document that provides information relevant to a topic or entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Documentary Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ECProject -->


    <owl:Class rdf:about="http://aiod.eu/data/ECProject">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Project"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/eu_contribution"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A project directly funded or co-funded by the European Commission.</rdfs:comment>
        <rdfs:label xml:lang="en">EC Project</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/EcosystemResource -->


    <owl:Class rdf:about="http://aiod.eu/data/EcosystemResource">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIResource"/>
        <rdfs:comment>Indirect contributions to the research and development of AI assets.</rdfs:comment>
        <rdfs:label xml:lang="en">Ecosystem Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/EducationalCompetency -->


    <owl:Class rdf:about="http://aiod.eu/data/EducationalCompetency">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Educational Competency Level</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/EducationalLevel -->


    <owl:Class rdf:about="http://aiod.eu/data/EducationalLevel">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Educational Level</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/EducationalResource -->


    <owl:Class rdf:about="http://aiod.eu/data/EducationalResource">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/EcosystemResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/offered_by"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Organisation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A resource designed for educational purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">Educational Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Event -->


    <owl:Class rdf:about="http://aiod.eu/data/Event">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/EcosystemResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/duration"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Size"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/organiser"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An event happening at a certain time and location, with a specific scope.</rdfs:comment>
        <rdfs:label xml:lang="en">Event</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/EventMode -->


    <owl:Class rdf:about="http://aiod.eu/data/EventMode">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Event Mode</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/EventStatus -->


    <owl:Class rdf:about="http://aiod.eu/data/EventStatus">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Event Status</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Experiment -->


    <owl:Class rdf:about="http://aiod.eu/data/Experiment">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:comment>A procedure conducted to test theoretical knowledge.</rdfs:comment>
        <rdfs:label xml:lang="en">Experiment</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ExperimentExecution -->


    <owl:Class rdf:about="http://aiod.eu/data/ExperimentExecution">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:comment>The actual conduct of a previously defined experiment.</rdfs:comment>
        <rdfs:label xml:lang="en">Experiment Execution</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ExpertGroup -->


    <owl:Class rdf:about="http://aiod.eu/data/ExpertGroup">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Agent"/>
        <rdfs:comment>A team of experts who have no legal foundation and are assembled for a specific purpose.</rdfs:comment>
        <rdfs:label xml:lang="en">Expert Group</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Expertise -->


    <owl:Class rdf:about="http://aiod.eu/data/Expertise">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>The area of specialization and practical experience.</rdfs:comment>
        <rdfs:label xml:lang="en">Expertise</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/FundingOpportunity -->


    <owl:Class rdf:about="http://aiod.eu/data/FundingOpportunity">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/NewsItem"/>
        <rdfs:comment>An article highlighting opportunities for financial support.</rdfs:comment>
        <rdfs:label xml:lang="en">Funding Opportunity</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Image -->


    <owl:Class rdf:about="http://aiod.eu/data/Image">
        <owl:equivalentClass rdf:resource="http://xmlns.com/foaf/0.1/Image"/>
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Multimedia"/>
        <rdfs:comment>The depiction/visual representation of static elements.</rdfs:comment>
        <rdfs:label xml:lang="en">Image</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/InformationalService -->


    <owl:Class rdf:about="http://aiod.eu/data/InformationalService">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Service"/>
        <rdfs:label xml:lang="en">Informational Service</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/InnovationService -->


    <owl:Class rdf:about="http://aiod.eu/data/InnovationService">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Service"/>
        <rdfs:label xml:lang="en">Innovation Service</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/InvolvementLevel -->


    <owl:Class rdf:about="http://aiod.eu/data/InvolvementLevel">
        <rdfs:label xml:lang="en">Involvement Level</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/JobAnnouncement -->


    <owl:Class rdf:about="http://aiod.eu/data/JobAnnouncement">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/NewsItem"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://aiod.eu/data/issuer"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://aiod.eu/data/Organisation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An article highlighting employment opportunities.</rdfs:comment>
        <rdfs:label xml:lang="en">Job Announcement</rdfs:label>
        <skos:relatedMatch rdf:resource="http://data.europa.eu/esco/model#Occupation"/>
        <skos:relatedMatch rdf:resource="http://www.w3.org/ns/org#Post"/>
        <skos:relatedMatch rdf:resource="https://w3id.org/saro#JobPosting"/>
    </owl:Class>
    


    <!-- http://aiod.eu/data/KnowledgeAsset -->


    <owl:Class rdf:about="http://aiod.eu/data/KnowledgeAsset">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIAsset"/>
        <rdfs:comment>An AI Asset used as an information item for other entities, such as assets and scientific areas.</rdfs:comment>
        <rdfs:label xml:lang="en">Knowledge Asset</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Language -->


    <owl:Class rdf:about="http://aiod.eu/data/Language">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:label xml:lang="en">Language</rdfs:label>
    </owl:Class>
    


