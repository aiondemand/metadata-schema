        <rdfs:comment xml:lang="en">A hardware unit that contributes to computational performance.</rdfs:comment>
        <rdfs:label xml:lang="en">Compute Component</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/ContactDetails -->


    <owl:Class rdf:about="http://aiod.eu/data/ContactDetails">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/AIoDConcept"/>
        <rdfs:comment>Information related to communication methods.</rdfs:comment>
        <rdfs:label xml:lang="en">Contact Details</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Container -->


    <owl:Class rdf:about="http://aiod.eu/data/Container">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/Distribution"/>
        <rdfs:label xml:lang="en">Container</rdfs:label>
    </owl:Class>
    


    <!-- http://aiod.eu/data/Course -->


    <owl:Class rdf:about="http://aiod.eu/data/Course">
        <rdfs:subClassOf rdf:resource="http://aiod.eu/data/EducationalResource"/>
